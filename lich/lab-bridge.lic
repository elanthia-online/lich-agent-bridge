=begin
  Lich Agent Bridge: GemStone IV copilot bridge.

  Start once with:  ;lab
  Then ask with:    , what just happened?
  Check status:     ;lab status
  Disable actions:  ;lab actions off
  Stop with:        ;lab stop

  The bridge observes game text and talks only to a loopback sidecar. Its
  command path and allowlisted auto-approval start enabled. The bridge
  independently rechecks a small allowlist before sending one command at a
  time.

  project: https://github.com/elanthia-online/lich-agent-bridge
  version: 0.3.0
     game: gs
=end

require 'json'
require 'net/http'
require 'securerandom'
require 'time'
require 'uri'
lich_state_core = if defined?($script_dir) && $script_dir
                    File.join($script_dir, 'lich-state-core')
                  else
                    File.expand_path('lich-state-core', __dir__)
                  end
controller_registry_core = if defined?($script_dir) && $script_dir
                             File.join($script_dir, 'lab-controller-registry')
                           else
                             File.expand_path('lab-controller-registry', __dir__)
                           end
controller_registry_source = File.realpath("#{controller_registry_core}.rb")
require File.join(File.dirname(controller_registry_core), 'lab-controller-controls')
require File.join(File.dirname(controller_registry_core), 'lab-combat-report')
# `lab-bridge.lic` can be loaded repeatedly inside one long-lived Lich Ruby
# process. Replace LAB's private registry namespace before loading so an
# in-place deploy cannot retain an older manifest contract.
Object.send(:remove_const, :LabControllerRegistry) if Object.const_defined?(:LabControllerRegistry, false)
load controller_registry_source
if ENV['LAB_BRIDGE_LIBRARY_ONLY'] == '1'
  require lich_state_core
else
  # The state extractor is also reloadable after `;lab stop` / `;lab`.
  load "#{lich_state_core}.rb"
end

hide_me

module LichAgentBridge
  HOST = '127.0.0.1'
  PORT = Integer(ENV.fetch('LAB_PORT', '18765'))
  BASE_URI = URI("http://#{HOST}:#{PORT}")
  UPSTREAM_HOOK = "lab-upstream-#{Script.current.object_id}"
  DOWNSTREAM_HOOK = "lab-downstream-#{Script.current.object_id}"
  MAX_PENDING = 500
  MAX_BATCH = 50
  MAX_LINE = 4_000
  FAMILIAR_STREAM = 'familiar'
  FAMILIAR_CLOSED_STYLE = 'watching'
  XML_TEXT_ESCAPES = {
    '&' => '&amp;',
    '<' => '&lt;',
    '>' => '&gt;',
    '"' => '&quot;',
    "'" => '&apos;'
  }.freeze
  ACTION_REGISTRATION_INTERVAL = 15
  SNAPSHOT_HEARTBEAT_INTERVAL = 15
  CONTROLLER_MANIFEST_PATH = ENV.fetch(
    'LAB_CONTROLLER_MANIFEST',
    if defined?($script_dir) && $script_dir
      File.join($script_dir, 'lab-controllers.json')
    else
      File.expand_path('lab-controllers.json', __dir__)
    end
  )
  CONTROLLER_REGISTRY = LabControllerRegistry::Registry.load(CONTROLLER_MANIFEST_PATH)
  SPELL_STATE_MESSAGES = {
    '401' => {
      down: /\AThe silvery luminescence fades from around you\.\z/,
      up: /\AA silvery luminescence surrounds you\.\z/
    },
    '414' => {
      down: /\AThe brilliant luminescence fades from around you\.\z/,
      up: /\AA brilliant luminescence surrounds you\.\z/
    },
    '430' => {
      down: /\AThe tingling sensation and sense of security leaves you\.\z/,
      up: /\AYour skin tingles for a moment and you feel more secure\.\z/
    },
    '716' => {
      down: /\AYou exhale the last of a virulent green mist\.\z/,
      up: /\AA cankerous ripple of vesicles temporarily disfigures your face and travels down your body, leaving a sickly green miasma as it disappears\.\z/
    }
  }.freeze
  INFOMON_SPELL_ENDED = /\A\[\s*(\d+)\s+[^:]+:\s+Ended\s*\]\z/
  ACTION_TOKEN_FILE = ENV.fetch(
    'LAB_ACTION_TOKEN_FILE',
    File.join(Dir.home, '.local', 'state', 'lich-agent-bridge', 'action-token')
  )
  SAFE_ACTIONS = [
    /\A(?:armor info|armor list all|ascension info|bounty|cman info|encumbrance|exp|feat info|gld|health|info|inspect ready weapon links|inventory|look|mana|ready list|ready weapon set|resource|skills|shield info|society|spell active|spirit|stamina|stow list|weapon info)\z/i,
    /\Aready weapon clear\z/i,
    /\Aready weapon #[0-9]+\z/i,
    /\Aready weapon set #[0-9]+\z/i,
    /\A(?:mark|register) [^\r\n]{1,130}\z/i,
    /\Aset (?:nomarkeddrop|saferdrop) on\z/i,
    /\Ago2 getsilvers (?:on|off)\z/i,
    /\Aeloot keep closed on\z/i,
    /\Aeloot (?:loot|sell|stop)\z/i,
    /\Aeherbs heal\z/i,
    /\Abigshot (?:start|stop)\z/i,
    /\Aebounty (?:start|stop)\z/i,
    *CONTROLLER_REGISTRY.safe_patterns,
    /\Abeseech teleport\z/i,
    /\A(?:flag|stow set|store set) [^\r\n]{1,130}\z/i,
    /\A(?:north|northeast|east|southeast|south|southwest|west|northwest|out|up|down|n|ne|e|se|s|sw|w|nw|u|d)\z/i,
    /\A(?:go|climb|enter) [a-z0-9][a-z0-9 #'_-]{0,119}\z/i,
    /\Ago2 [0-9]+\z/i,
    /\Ago2 supervised [1-9][0-9]{0,9}\z/i,
    /\A(?:say|whisper|tell|ask) [^\r\n]{1,140}\z/i,
    /\Ainspect item exact [^\r\n]{1,120}\z/i,
    /\Adiagnose item (?:405|735) exact [^\r\n]{1,120}\z/i,
    /\A(?:look|read|inspect|analyze|assess|appraise|browse|shop)(?:\s+[^\r\n]{1,130})?\z/i,
    /\A(?:get|take|remove|wear|stow|sheath|gird|open|close) [^\r\n]{1,130}\z/i,
    /\Aput [^\r\n]{1,90} (?:in|into|on|under|behind) [^\r\n]{1,90}\z/i,
    /\A(?:buy|order)\z/i,
    /\A(?:buy|order|bid|deposit|withdraw|tip) [^\r\n]{1,130}\z/i,
    /\Apour (?:#[0-9]+|my (?:[a-z0-9][a-z0-9 #'_-]{0,84} )?potion) on (?:#[0-9]+|my (?:[a-z0-9][a-z0-9 #'_-]{0,84} )?(?:stone|runestone))\z/i,
    /\Adip (?:#[0-9]+|my (?:[a-z0-9][a-z0-9 #'_-]{0,84} )?brush) in (?:#[0-9]+|my (?:[a-z0-9][a-z0-9 #'_-]{0,84} )?(?:ink|cup))\z/i,
    /\Adraw [a-z]{1,20}'[a-z]{1,20} rune\z/i,
    /\Awave (?:#[0-9]+|my (?:[a-z0-9][a-z0-9 #'_-]{0,84} )?(?:stone|runestone)) at (?:#[0-9]+|my [a-z0-9][a-z0-9 #'_-]{0,110})\z/i,
    /\A(?:prep|prepare) 714\z/i,
    /\Ainfuse (?:#[0-9]+|my [a-z0-9][a-z0-9 #'_-]{0,110})\z/i,
    /\A(?:attack|kill|berserk|mstrike|stance|retreat|advance|cman|warcry|sign|incant|cast|evoke|ambush|punch|kick|jab|grapple)(?:\s+[^\r\n]{1,130})?\z/i
  ].freeze
  FORBIDDEN_ACTIONS = [
    /\A(?:drop|discard|trash|sell|give|offer|exchange|trade|mail|place|throw|hurl|empty|destroy|sacrifice)(?:\s|\z)/i,
    /\A(?:unmark(?:\s|\z)|mark .+ remove\z)/i,
    /\Aset (?:nomarkeddrop|saferdrop) off\z/i,
    /\Aput .+ (?:on|in|into) (?:the )?(?:ground|floor|room)\z/i
  ].freeze
  MAX_SEQUENCE_COMMANDS = 12
  MAX_SEQUENCE_LENGTH = 1200
  SequenceOwnershipError = Class.new(StandardError)
  SAFE_SEQUENCE_ACTIONS = [
    /\A(?:info|skills)\z/i,
    /\A(?:look|read|inspect)(?:\s+[^\r\n]{1,130})?\z/i,
    /\A(?:get|take|remove|wear|stow|sheath|gird|open|close) [^\r\n]{1,130}\z/i,
    /\Aput [^\r\n]{1,90} (?:in|into|on|under|behind) [^\r\n]{1,90}\z/i,
    /\Apour (?:#[0-9]+|my (?:[a-z0-9][a-z0-9 #'_-]{0,84} )?potion) on (?:#[0-9]+|my (?:[a-z0-9][a-z0-9 #'_-]{0,84} )?(?:stone|runestone))\z/i,
    /\Adip (?:#[0-9]+|my (?:[a-z0-9][a-z0-9 #'_-]{0,84} )?brush) in (?:#[0-9]+|my (?:[a-z0-9][a-z0-9 #'_-]{0,84} )?(?:ink|cup))\z/i,
    /\Adraw [a-z]{1,20}'[a-z]{1,20} rune\z/i,
    /\Awave (?:#[0-9]+|my (?:[a-z0-9][a-z0-9 #'_-]{0,84} )?(?:stone|runestone)) at (?:#[0-9]+|my [a-z0-9][a-z0-9 #'_-]{0,110})\z/i,
    /\A(?:prep|prepare) 714\z/i,
    /\Acast at #[0-9]+\z/i,
    /\Ainfuse (?:#[0-9]+|my [a-z0-9][a-z0-9 #'_-]{0,110})\z/i
  ].freeze
  SEQUENCE_FAILURE = /(?:
    What\s+were\s+you\s+referring\s+to\? |
    Please\s+rephrase\s+that\s+command |
    I\s+could\s+not\s+find |
    You\s+(?:do\s+not|don't)\s+(?:have|seem\s+to\s+have) |
    You\s+(?:aren't|are\s+not)\s+holding |
    You\s+(?:can't|cannot|may\s+not|are\s+unable\s+to) |
    That\s+is\s+closed
  )/ix

  @pending = []
  @pending_mutex = Mutex.new
  @running = true
  @actions_enabled = true
  @execution_mutex = Mutex.new
  @sequence_response_mutex = Mutex.new
  @sequence_response_cv = ConditionVariable.new
  @sequence_prompt_counter = 0
  @sequence_response_waiter = nil
  @last_observe_error_at = Time.at(0)
  @last_action_error_at = Time.at(0)
  @last_action_registration_at = Time.at(0)
  @last_action_registration_error_at = Time.at(0)
  @pending_approval_id = nil
  @auto_approve = true
  @raw_capture_until = Time.at(0)
  @raw_capture_path = nil
  @session_generation = SecureRandom.hex(16)
  @snapshot_sequence = 0
  @last_snapshot_signature = nil
  @last_snapshot_at = Time.at(0)
  @snapshot_generation_rejected = false
  @diagnostic_capture = nil
  @diagnostic_capture_mutex = Mutex.new
  @last_observation = nil
  @script_status = {}
  @script_status_mutex = Mutex.new
  @observed_inactive_spells = {}
  @spell_evidence_mutex = Mutex.new
  @live_state_source = nil
  @command_queue = Queue.new
  @question_mutex = Mutex.new
  @question_epoch = 0

  def self.display(message)
    message.to_s.each_line do |line|
      text = "--- LAB: #{line.chomp}"
      if defined?(_respond)
        _respond(familiar_stream_frame(text))
      else
        respond(text)
      end
    end
  end

  def self.live_state_source
    @live_state_source ||= LichState::LichSource.new
  end

  def self.familiar_stream_frame(text)
    source = text.to_s
    utf8_text = if source.encoding == Encoding::BINARY
                  source.dup.force_encoding(Encoding::UTF_8).scrub("\uFFFD")
                else
                  source.encode(
                    Encoding::UTF_8,
                    invalid: :replace,
                    undef: :replace,
                    replace: "\uFFFD"
                  )
                end
    escaped = utf8_text
      .gsub(/[^\u0009\u000A\u000D\u0020-\uD7FF\uE000-\uFFFD\u{10000}-\u{10FFFF}]/, "\uFFFD")
      .gsub(/[&<>"']/) { |character| XML_TEXT_ESCAPES.fetch(character) }
    "<pushStream id=\"#{FAMILIAR_STREAM}\" ifClosedStyle=\"#{FAMILIAR_CLOSED_STYLE}\"/>#{escaped}\n<popStream/>\n"
  end

  def self.character_name
    XMLData.name.to_s.empty? ? 'Unknown' : XMLData.name.to_s
  end

  def self.room_id
    Map.current&.id&.to_s
  rescue
    nil
  end

  def self.room_fingerprint
    room_id || 'unknown'
  end

  def self.session_generation
    @session_generation
  end

  def self.record_spell_evidence(line)
    spell_id = nil
    state = nil
    SPELL_STATE_MESSAGES.each do |candidate, messages|
      if messages.fetch(:down).match?(line)
        spell_id = candidate
        state = :down
        break
      elsif messages.fetch(:up).match?(line)
        spell_id = candidate
        state = :up
        break
      end
    end
    if state.nil? && (match = INFOMON_SPELL_ENDED.match(line))
      spell_id = match[1]
      state = :down
    end
    return false unless spell_id

    @spell_evidence_mutex.synchronize do
      if state == :down
        @observed_inactive_spells[spell_id] = Time.now
      else
        @observed_inactive_spells.delete(spell_id)
      end
    end
    if state == :down && defined?(Spell) && Spell.respond_to?(:[])
      spell = Spell[spell_id.to_i]
      spell.putdown if spell && spell.respond_to?(:putdown) && spell.active?
    end
    true
  rescue => error
    Lich.log("lab bridge spell evidence error: #{error.class}: #{error.message}") if defined?(Lich)
    false
  end

  def self.live_scripts
    return [] unless defined?(Script) && Script.respond_to?(:running)

    scripts = Array(Script.running)
    scripts.concat(Array(Script.hidden)) if Script.respond_to?(:hidden)
    scripts.filter_map { |script| script.respond_to?(:name) ? script.name.to_s : nil }
           .reject(&:empty?).uniq.sort.first(100)
  rescue
    []
  end

  def self.script_owners(scripts)
    folded = scripts.map(&:downcase)
    tracker_activity = inventory_tracker_activity
    folded << 'lab-inventory' if tracker_activity == true
    movement_candidates = %w[go2 bigshot ebounty escortgo2 echild] + CONTROLLER_REGISTRY.controller_scripts_for_lane('movement')
    combat_candidates = %w[bigshot] + CONTROLLER_REGISTRY.controller_scripts_for_lane('combat')
    movement = movement_candidates.uniq.find { |name| folded.include?(name) }
    combat = combat_candidates.uniq.find { |name| folded.include?(name) }
    inventory_candidates = %w[eloot eherbs lab-inventory] + CONTROLLER_REGISTRY.controller_scripts_for_lane('inventory')
    inventory_candidates.delete('lab-inventory') if tracker_activity == false
    inventory = inventory_candidates.uniq.find { |name| folded.include?(name) }
    {
      movement: movement,
      combat: combat,
      inventory: inventory,
      communication: nil
    }
  end

  def self.inventory_tracker_activity
    return nil unless defined?(LabInventory) && LabInventory.respond_to?(:inventory_lane_active?)
    value = LabInventory.inventory_lane_active?
    [true, false].include?(value) ? value : nil
  rescue StandardError
    nil
  end

  def self.live_script_status(scripts)
    running = scripts.map(&:downcase)
    @script_status_mutex.synchronize do
      controller_scripts = CONTROLLER_REGISTRY.controllers.map(&:script)
      (%w[bigshot eloot go2] + controller_scripts).uniq.each do |name|
        if running.include?(name)
          @script_status[name] = 'running'
        elsif @script_status[name] == 'running'
          @script_status[name] = 'completed'
        end
      end
      @script_status.dup
    end
  end

  def self.set_script_status(name, status)
    @script_status_mutex.synchronize { @script_status[name.to_s.downcase] = status }
  end

  def self.live_state_context
    scripts = live_scripts
    inactive_spell_ids = @spell_evidence_mutex.synchronize do
      @observed_inactive_spells.keys.dup
    end
    {
      generation: @session_generation,
      inactive_spell_ids: inactive_spell_ids,
      scripts: scripts,
      owners: script_owners(scripts),
      script_status: live_script_status(scripts)
    }
  end

  def self.monitor_script_completion(
    name,
    execution_id:,
    startup_timeout: 3,
    completion_timeout: 20
  )
    Thread.new do
      startup_deadline = Time.now + startup_timeout
      completion_deadline = Time.now + completion_timeout
      started = false
      finished = false
      loop do
        running = Script.running?(name)
        started ||= running
        if started && !running
          finished = true
          break
        end
        break if !started && Time.now >= startup_deadline
        break if Time.now >= completion_deadline

        sleep 0.1
      end
      status = if finished
                 'completed'
               elsif started
                 'timed_out'
               else
                 'failed'
               end
      set_script_status(name, "#{status}:#{execution_id}")
      publish_snapshot(force: true)
    rescue => error
      set_script_status(name, 'failed')
      Lich.log("lab bridge script monitor failed: #{error.class}: #{error.message}")
    end
  end

  def self.controller_global_value(global_name)
    TOPLEVEL_BINDING.eval(global_name)
  rescue NameError
    nil
  end

  def self.clear_controller_result(controller)
    TOPLEVEL_BINDING.eval("#{controller.result_global} = nil")
  end

  def self.set_controller_signal(controller, value)
    raise 'controller has no signal' unless controller.signal_global

    literal = value ? 'true' : 'false'
    TOPLEVEL_BINDING.eval("#{controller.signal_global} = #{literal}")
  end

  def self.controller_result(controller)
    controller_global_value(controller.result_global)
  end

  def self.result_field(result, key)
    return nil unless result.is_a?(Hash)
    return result[key] if result.key?(key)

    result[key.to_s]
  end

  def self.normalized_controller_result(controller, fallback_code: 'missing_result', fallback_message: nil)
    result = controller_result(controller)
    unless result.is_a?(Hash)
      return {
        ok: false,
        code: fallback_code,
        message: fallback_message || "#{controller.script} returned no structured result",
        details: {}
      }
    end

    details = result_field(result, :details)
    details = {} unless details.is_a?(Hash)
    details = JSON.parse(JSON.generate(details))
    {
      ok: result_field(result, :ok) == true,
      code: result_field(result, :code).to_s[0, 128],
      message: result_field(result, :message).to_s[0, 500],
      details: details
    }
  rescue JSON::GeneratorError
    {
      ok: false,
      code: 'malformed_result',
      message: "#{controller.script} returned non-JSON result details",
      details: {}
    }
  end

  def self.publish_controller_result(controller, execution_id, result)
    publish_event(
      'controller_result',
      "#{controller.name} controller #{result.fetch(:code)}",
      {
        controller: controller.name,
        script: controller.script,
        action_id: execution_id.to_s,
        ok: result.fetch(:ok),
        code: result.fetch(:code),
        message: result.fetch(:message),
        details: result.fetch(:details)
      }
    )
  end

  # A controller owns its lifetime. The monitor waits for observed script exit,
  # publishes the post-state first, then emits one action-attributed result.
  def self.monitor_controller(controller, execution_id:, startup_timeout: 3)
    Thread.new do
      startup_deadline = Time.now + startup_timeout
      until Script.running?(controller.script) || controller_result(controller).is_a?(Hash) || Time.now >= startup_deadline
        sleep 0.05
      end
      sleep 0.1 while Script.running?(controller.script)
      result = normalized_controller_result(controller)
      set_script_status(controller.script, "#{result.fetch(:code)}:#{execution_id}")
      publish_snapshot(force: true)
      publish_controller_result(controller, execution_id, result)
    rescue => error
      set_script_status(controller.script, "failed:#{execution_id}")
      Lich.log("lab bridge #{controller.name} monitor failed: #{error.class}: #{error.message}")
    end
  end

  def self.launch_bigshot(startup_timeout: 3)
    return true if Script.running?('bigshot')

    Thread.new do
      Script.run('bigshot', nil, { quiet: true })
    rescue => error
      Lich.log("lab bridge Bigshot launch failed: #{error.class}: #{error.message}")
    end
    deadline = Time.now + startup_timeout
    until Script.running?('bigshot') || Time.now >= deadline
      sleep 0.05
    end
    Script.running?('bigshot')
  end

  def self.launch_controller(controller, controller_action, arguments, startup_timeout: 3)
    return false if Script.running?(controller.script)

    if controller_action.launch_mode == 'start'
      return false unless Script.start(controller.script, arguments)
    else
      Thread.new do
        Script.run(controller.script, arguments, { quiet: true })
      rescue => error
        Lich.log("lab bridge #{controller.name} launch failed: #{error.class}: #{error.message}")
      end
    end
    deadline = Time.now + startup_timeout
    until Script.running?(controller.script) || controller_result(controller).is_a?(Hash) || Time.now >= deadline
      sleep 0.05
    end
    Script.running?(controller.script) || controller_result(controller).is_a?(Hash)
  rescue => error
    Lich.log("lab bridge #{controller.name} launch failed: #{error.class}: #{error.message}")
    false
  end

  def self.snapshot_state(extracted: nil)
    sample = extracted
    unless sample&.hub
      sample = live_state_source.extract(
        projection_types: [],
        hub_context: live_state_context
      )
    end
    state = sample&.hub
    raise 'coherent live state is unavailable' unless state

    state
  end

  def self.snapshot_signature(state)
    stable = state.dup
    stable[:active_spells] = Array(state[:active_spells]).map { |spell| { id: spell[:id] } }
    JSON.generate(stable)
  end

  def self.publish_snapshot(force: false, extracted: nil)
    return false if @snapshot_generation_rejected
    return false if character_name == 'Unknown'

    state = snapshot_state(extracted: extracted)
    signature = snapshot_signature(state)
    heartbeat_due = Time.now - @last_snapshot_at >= SNAPSHOT_HEARTBEAT_INTERVAL
    return false unless force || heartbeat_due || signature != @last_snapshot_signature

    @snapshot_sequence += 1
    payload = state.merge(
      sequence: @snapshot_sequence,
      observed_at: Time.now.utc.iso8601(6)
    )
    request(:post, '/v1/state', payload, authorized: true)
    @last_snapshot_signature = signature
    @last_snapshot_at = Time.now
    true
  rescue => error
    if error.message.include?('409')
      @snapshot_generation_rejected = true
      @actions_enabled = false
      @pending_approval_id = nil
      Lich.log("lab bridge snapshot generation rejected; restart ;lab to establish a fresh session: #{error.message}")
    end
    raise error
  end

  def self.publish_event(kind, summary, data = {})
    request(
      :post,
      '/v1/event',
      {
        character: character_name,
        generation: @session_generation,
        observed_at: Time.now.utc.iso8601(3),
        kind: kind.to_s[0, 128],
        summary: summary.to_s[0, MAX_LINE],
        data: data
      },
      authorized: true
    )
    true
  rescue => error
    Lich.log("lab bridge event publish failed: #{error.class}: #{error.message}")
    false
  end

  def self.diagnostic_evidence?(lines, item)
    return false if lines.empty?

    combined = lines.join(' ').downcase
    failure = /\b(?:cannot|can't|unable|failed|nothing happens|not holding|do not have)\b/i
    return false if failure.match?(combined)

    candidates = [item.noun, item.name, item.full_name].compact.map do |value|
      normalize_item_name(value).downcase
    end.reject { |value| value.length < 3 }.uniq
    candidates.any? { |value| combined.include?(value) }
  rescue
    false
  end

  def self.capture_diagnostic(method, object_id, action_id, item)
    capture = {
      method: method.to_s,
      object_id: object_id.to_s,
      lines: [],
      last_line_at: Time.now
    }
    @diagnostic_capture_mutex.synchronize do
      raise 'another diagnostic capture is active' if @diagnostic_capture

      @diagnostic_capture = capture
    end
    yield
    deadline = Time.now + 3
    loop do
      line_count, last_line_at = @diagnostic_capture_mutex.synchronize do
        [capture[:lines].length, capture[:last_line_at]]
      end
      break if Time.now >= deadline
      break if line_count.positive? && Time.now - last_line_at >= 0.25

      sleep 0.05
    end
    lines = @diagnostic_capture_mutex.synchronize do
      @diagnostic_capture = nil if @diagnostic_capture.equal?(capture)
      capture[:lines].dup
    end
    attributable = diagnostic_evidence?(lines, item)
    published = false
    if attributable
      published = publish_event(
        'item_diagnostic',
        "#{method} evidence for exact item ##{object_id}",
        {
          method: method.to_s,
          object_id: object_id.to_s,
          action_id: action_id.to_s,
          success: true,
          lines: lines,
          line_count: lines.length
        }
      )
    end
    { lines: lines, published: published, attributable: attributable }
  ensure
    @diagnostic_capture_mutex.synchronize do
      @diagnostic_capture = nil if defined?(capture) && @diagnostic_capture.equal?(capture)
    end
  end

  def self.capture(server_string)
    if @raw_capture_path && Time.now < @raw_capture_until
      File.open(@raw_capture_path, 'a', encoding: 'UTF-8') do |stream|
        stream.write(server_string)
      end
    end
    text = strip_xml(server_string.dup, type: DOWNSTREAM_HOOK)
    normalized_lines = []
    text.to_s.split(/\r?\n/).each do |line|
      normalized = line.gsub(/\s+/, ' ').strip
      next if normalized.empty?
      normalized_lines << normalized

      record_spell_evidence(normalized)

      @diagnostic_capture_mutex.synchronize do
        if @diagnostic_capture
          @diagnostic_capture[:lines] << normalized[0, MAX_LINE]
          @diagnostic_capture[:lines].shift while @diagnostic_capture[:lines].length > 80
          @diagnostic_capture[:last_line_at] = Time.now
        end
      end

      event = {
        timestamp: Time.now.utc.iso8601(3),
        character: character_name,
        game: XMLData.game.to_s,
        room_id: room_id,
        source: 'game',
        text: normalized[0, MAX_LINE]
      }
      @last_observation = event
      @pending_mutex.synchronize do
        @pending.shift while @pending.length >= MAX_PENDING
        @pending << event
      end
    end
    live_state_source.observe_character_data(server_string, normalized_lines)
    observe_sequence_response(server_string, normalized_lines)
    server_string
  rescue => error
    Lich.log("lab bridge capture error: #{error.class}: #{error.message}")
    server_string
  end

  def self.observe_sequence_response(server_string, normalized_lines)
    prompt_received = server_string.to_s.match?(/<prompt(?:\s|>)/)
    @sequence_response_mutex.synchronize do
      if @sequence_response_waiter
        Array(normalized_lines).each do |line|
          if @sequence_response_waiter[:failure].nil? && SEQUENCE_FAILURE.match?(line.to_s)
            @sequence_response_waiter[:failure] = line.to_s
            @sequence_response_waiter[:acknowledged] = true
          end
        end
        if sequence_command_acknowledged?(
          @sequence_response_waiter[:command],
          server_string,
          normalized_lines
        )
          @sequence_response_waiter[:acknowledged] = true
        end
        if prompt_received && @sequence_response_waiter[:acknowledged]
          @sequence_response_waiter[:complete] = true
        end
      end
      if prompt_received
        @sequence_prompt_counter += 1
        @sequence_response_cv.broadcast
      end
    end
  end

  def self.sequence_command_acknowledged?(command, server_string, normalized_lines)
    if %w[info skills].include?(command.to_s.downcase)
      starting_revision = @sequence_response_waiter && @sequence_response_waiter[:recon_revision]
      return starting_revision && live_state_source.character_recon_revision(command.to_s.downcase) > starting_revision
    end
    raw = server_string.to_s
    exact_ids = command.to_s.scan(/#([0-9]+)/).flatten
    return true if exact_ids.any? do |id|
      raw.match?(/\bexist=(?:"#{Regexp.escape(id)}"|'#{Regexp.escape(id)}')/)
    end

    patterns = case command.to_s
               when /\Aput\s/i
                 [/\AYou (?:put|place|roll|slide|slip|stow|tuck|secure|buckle)\b/i]
               when /\A(?:get|take)\s/i
                 [/\AYou (?:get|take|remove|retrieve|slide|undo|unfasten|pull|draw)\b/i]
               when /\Aremove\s/i
                 [/\AYou (?:remove|take off|unfasten|undo|slip)\b/i]
               when /\Awear\s/i
                 [/\AYou (?:wear|put on|don|fasten|slip)\b/i]
               when /\Aopen\s/i
                 [/\AYou (?:open|unfasten|undo|pull|slide)\b/i]
               when /\Aclose\s/i
                 [/\AYou (?:close|fasten|buckle|seal|shut|roll)\b/i]
               when /\A(?:look|inspect)\s/i
                 [/\AYou (?:see|look|inspect|notice)\b/i]
               when /\Aread\s/i
                 [/\A(?:It takes you|On the\b|You (?:read|study|focus))\b/i]
               when /\Awave\s/i
                 [/\AYou wave\b/i]
               when /\Apour\s/i
                 [/\AYou pour\b/i]
               when /\Adip\s/i
                 [/\AYou dip\b/i]
               when /\Adraw\s/i
                 [/\AYou (?:draw|carefully draw|carefully trace out|begin drawing)\b/i]
               when /\A(?:prep|prepare)\s+714\z/i
                 [
                   /\AYou (?:trace|gesture|prepare|begin preparing)\b/i,
                   /\AYour spell is ready\.\z/i,
                   /\AClawing its way violently up your throat\b/i
                 ]
               when /\Acast at #[0-9]+\z/i
                 [/\AYou gesture at\b/i, /\AYou focus your thoughts upon\b/i]
               when /\Ainfuse\s/i
                 [/\AYou (?:infuse|channel|focus|reach|gesture)\b/i]
               else
                 []
               end
    Array(normalized_lines).any? do |line|
      patterns.any? { |pattern| pattern.match?(line.to_s) }
    end
  end

  # Send exactly once, then wait for the authoritative server prompt.  fput
  # cannot provide this guarantee here because frontend state frames can be the
  # first downstream line and make it return before the game handles the
  # command.  That early return can overwrite the next inventory capture or
  # advance a crafting sequence while cast roundtime is still being published.
  def self.send_sequence_command(command, timeout: 20)
    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout.to_f
    waiter = { command: command.to_s, failure: nil, acknowledged: false, complete: false }
    if %w[info skills].include?(command.to_s.downcase)
      waiter[:recon_revision] = live_state_source.character_recon_revision(command.to_s.downcase)
    end
    result = false

    @sequence_response_mutex.synchronize do
      starting_prompt = @sequence_prompt_counter
      @sequence_response_waiter = waiter
      begin
        put(command)
        while @running && !waiter[:complete]
          remaining = deadline - Process.clock_gettime(Process::CLOCK_MONOTONIC)
          break if remaining <= 0
          @sequence_response_cv.wait(@sequence_response_mutex, remaining)
        end
        if waiter[:complete] && @sequence_prompt_counter > starting_prompt
          result = waiter[:failure] || true
        end
      ensure
        @sequence_response_waiter = nil if @sequence_response_waiter.equal?(waiter)
      end
    end
    result
  rescue => error
    Lich.log("lab bridge sequence command failed: #{error.class}: #{error.message}")
    false
  end

  def self.take_batch
    @pending_mutex.synchronize { @pending.shift(MAX_BATCH) }
  end

  def self.restore_batch(batch)
    @pending_mutex.synchronize do
      @pending = (batch + @pending).last(MAX_PENDING)
    end
  end

  def self.request(method, path, payload = nil, read_timeout: 5, authorized: false)
    uri = BASE_URI + path
    http = Net::HTTP.new(uri.host, uri.port)
    http.open_timeout = 1
    http.read_timeout = read_timeout
    request = method == :get ? Net::HTTP::Get.new(uri) : Net::HTTP::Post.new(uri)
    if authorized
      token = File.read(ACTION_TOKEN_FILE, encoding: 'UTF-8').strip
      raise 'action token is unavailable' unless token.match?(/\A[0-9a-f]{64}\z/)

      request['Authorization'] = "Bearer #{token}"
    end
    if payload
      request['Content-Type'] = 'application/json'
      request.body = JSON.generate(payload)
    end
    response = http.request(request)
    body = JSON.parse(response.body, symbolize_names: true)
    unless response.is_a?(Net::HTTPSuccess)
      raise "sidecar returned #{response.code}: #{body[:detail] || body[:error]}"
    end
    body
  end

  def self.action_request(path, payload)
    request(:post, path, payload, authorized: true)
  end

  # One coherent frontend-independent extraction feeds the LAB state snapshot.
  # Frontend adapters run in their own scripts and never participate here.
  def self.publish_tick
    extracted = live_state_source.extract(
      projection_types: [],
      hub_context: live_state_context
    )
    batch = take_batch
    begin
      request(:post, '/v1/observe', { events: batch }, authorized: true) unless batch.empty?
      publish_snapshot(extracted: extracted)
    rescue => error
      restore_batch(batch) unless batch.empty?
      if Time.now - @last_observe_error_at > 30
        Lich.log("lab bridge publish paused: #{error.class}: #{error.message}")
        @last_observe_error_at = Time.now
      end
      sleep 1
    end
  end

  def self.publish_loop
    while @running
      sleep 0.25
      publish_tick
    end
  end

  def self.ask(question)
    question_lock = @question_mutex.try_lock
    unless question_lock
      display('a question is already running for this character')
      return
    end
    expected_character = character_name
    expected_generation = session_generation
    expected_epoch = @question_epoch
    display('thinking...')
    health = request(:get, '/health')
    timeout = health[:ask_timeout_seconds]
    timeout = 120 unless timeout.is_a?(Numeric) && timeout.finite? && timeout.positive? && timeout <= 600
    return if expected_epoch != @question_epoch || expected_character != character_name || expected_generation != session_generation
    body = request(
      :post,
      '/v1/ask',
      { character: character_name, question: question },
      read_timeout: timeout + 5,
      authorized: true
    )
    display(body.fetch(:text)) if expected_epoch == @question_epoch && expected_character == character_name && expected_generation == session_generation
  rescue => error
    display("unavailable (#{error.message})")
  ensure
    @question_mutex.unlock if question_lock
  end

  def self.ensure_inventory_tracker
    return true if Script.running?('lab-inventory')

    !!Script.start('lab-inventory', { quiet: true })
  end

  # Management commands arrive through the short-lived lab.lic dispatcher.
  # Creating a worker there would attach it to that dispatcher's Lich thread
  # group, so Lich would kill the worker as soon as lab.lic exits.  Queue the
  # work for this persistent script to launch instead.  Each command still gets
  # its own worker so a slow model answer cannot block status or safety controls.
  def self.run_command_async(&work)
    @command_queue << work
    nil
  end

  def self.command_loop
    while @running
      work = @command_queue.pop
      break if work.nil? || !@running

      Thread.new { work.call }
    end
  end

  def self.status
    body = request(:get, '/health')
    unless body[:service] == 'lich-agent-bridge'
      raise "port #{PORT} belongs to another local service"
    end
    model = body[:model_configured] ? 'model configured' : 'model unavailable'
    actions = @actions_enabled ? 'actions enabled' : 'actions disabled'
    auto = @auto_approve ? 'auto-approve enabled' : 'auto-approve disabled'
    display("sidecar online, backend=#{body[:backend]}, #{model}, capability=#{body[:capability]}, #{actions}, #{auto}")
  rescue => error
    display("sidecar offline (#{error.message})")
  end

  def self.show_state
    state = snapshot_state
    room = state[:room]
    room_text = room ? "#{room[:id] || '?'} #{room[:title]}".strip : 'unknown'
    hands = state[:hands]
    right = hands[:right] ? "##{hands[:right][:id]} #{hands[:right][:name]}" : 'empty'
    left = hands[:left] ? "##{hands[:left][:id]} #{hands[:left][:name]}" : 'empty'
    vitals = state[:vitals]
    display(
      "#{state[:character]} room=#{room_text}; " \
      "health=#{vitals[:health][:current]}/#{vitals[:health][:max]} " \
      "mana=#{vitals[:mana][:current]}/#{vitals[:mana][:max]} " \
      "spirit=#{vitals[:spirit][:current]}/#{vitals[:spirit][:max]} " \
      "stamina=#{vitals[:stamina][:current]}/#{vitals[:stamina][:max]}"
    )
    display(
      "stance=#{state[:stance]} rt=#{state[:roundtime]} encumbrance=#{state[:encumbrance]}; " \
      "right=#{right}; left=#{left}"
    )
    display("scripts=#{state[:scripts].empty? ? 'none' : state[:scripts].join(', ')}")
  rescue => error
    display("state unavailable (#{error.message})")
  end

  def self.show_scripts
    scripts = live_scripts
    display("scripts=#{scripts.empty? ? 'none' : scripts.join(', ')}")
  end

  def self.show_inventory
    objects = inventory_objects
    hands = snapshot_state[:hands]
    right = hands[:right] ? "##{hands[:right][:id]} #{hands[:right][:name]}" : 'empty'
    left = hands[:left] ? "##{hands[:left][:id]} #{hands[:left][:name]}" : 'empty'
    display("inventory objects=#{objects.length}; right=#{right}; left=#{left}")
  end

  def self.show_last
    event = @last_observation
    if event
      display("last [#{event[:timestamp]} room=#{event[:room_id] || '?'}]: #{event[:text]}")
    else
      display('no game observation captured yet')
    end
  end

  def self.show_alerts
    body = request(
      :post,
      '/v1/session/alerts',
      { character: character_name },
      authorized: true
    )
    alerts = Array(body[:items])
    if alerts.empty?
      display('no active watcher alerts')
    else
      alerts.each do |alert|
        display("#{alert[:severity]} #{alert[:code]}: #{JSON.generate(alert[:evidence] || {})}")
      end
    end
  rescue => error
    display("alerts unavailable (#{error.message})")
  end

  def self.show_sources
    body = request(
      :post,
      '/v1/session/sources',
      { character: character_name },
      authorized: true
    )
    unless body[:answer_available]
      display('no answer provenance is available for this character yet')
      return nil
    end

    sources = Array(body[:sources])
    if sources.empty?
      display('no local reference excerpts were supplied to the last answer')
    else
      sources.each do |source|
        location = source[:url] || source[:source] || 'local reference'
        revision = source[:revision_id] ? " revision=#{source[:revision_id]}" : ''
        display("reference supplied: #{source[:title] || 'untitled'} [#{source[:authority] || 'reference'}] #{location}#{revision}")
      end
    end
    Array(body[:diagnostics]).each do |diagnostic|
      display("source status: #{diagnostic[:source]}=#{diagnostic[:status]} (#{diagnostic[:detail]})")
    end
  rescue => error
    display("sources unavailable (#{error.message})")
  end

  def self.show_context
    body = request(
      :post,
      '/v1/session/context',
      { character: character_name },
      authorized: true
    )
    categories = Array(body[:context_categories])
    display(
      "temporary dialogue turns=#{body[:dialogue_turns].to_i}; " \
      "follow-up context=#{body[:follow_up_context_available] ? 'available' : 'none'}; " \
      "categories=#{categories.empty? ? 'none' : categories.join(', ')}"
    )
  rescue => error
    display("context unavailable (#{error.message})")
  end

  def self.forget_context
    @question_epoch += 1
    body = request(
      :post,
      '/v1/session/forget',
      { character: character_name },
      authorized: true
    )
    if body[:forgotten]
      display('temporary dialogue and last-answer reference metadata cleared for this character')
    else
      display('no temporary dialogue was stored for this character')
    end
  rescue => error
    display("forget unavailable (#{error.message})")
  end

  def self.start_capability(capability, arguments = {})
    operation = request(
      :post,
      '/v1/session/perform',
      {
        character: character_name,
        capability: capability,
        args: arguments
      },
      authorized: true
    )
    operation_id = operation.fetch(:operation_id)
    display("operation #{operation_id} #{operation[:status]}: #{capability}")
    cursor = 0
    loop do
      page = request(
        :post,
        '/v1/session/operation/watch',
        {
          operation_id: operation_id,
          cursor: cursor,
          timeout_ms: 15_000
        },
        read_timeout: 17,
        authorized: true
      )
      Array(page[:items]).each do |event|
        display("operation #{operation_id} #{event[:status]}: #{event[:detail]}")
      end
      cursor = page[:cursor].to_i
      operation = page.fetch(:operation)
      break if %w[succeeded failed timed_out interrupted].include?(operation[:status].to_s)
    end
    display("operation #{operation_id} finished: #{operation[:status]} #{operation[:explanation]}")
  rescue => error
    display("operation unavailable (#{error.message})")
  end

  def self.stop_capability
    body = request(
      :post,
      '/v1/session/operation/stop',
      { character: character_name },
      authorized: true
    )
    if body[:stopped]
      display("interrupt requested for operation #{body[:operation_id]}")
    else
      display('no active operation to stop')
    end
  rescue => error
    display("stop unavailable (#{error.message})")
  end

  def self.set_actions(enabled)
    # This is the locally desired state.  Keep an explicit/default ON request
    # across a temporary sidecar outage so the reconciliation loop can restore
    # the sidecar's in-memory authorization when it becomes reachable.  An OFF
    # request remains off locally even if notifying the sidecar fails.
    if @snapshot_generation_rejected
      @actions_enabled = false
      @pending_approval_id = nil
      display('action execution remains OFF: this bridge session generation was rejected') if enabled
      return false
    end
    @actions_enabled = enabled
    unless enabled
      @pending_approval_id = nil
      @auto_approve = false
    end
    body = action_request(
      '/v1/actions/control',
      { character: character_name, generation: session_generation, enabled: enabled }
    )
    @actions_enabled = body.fetch(:enabled)
    @last_action_registration_at = Time.now if @actions_enabled
    state = @actions_enabled ? 'ON' : 'OFF'
    display("action execution #{state} for #{body.fetch(:character)}")
  rescue => error
    if enabled
      display("could not register action execution (#{error.message}); local request remains ON and will retry")
    else
      display("could not notify sidecar (#{error.message}); actions are OFF locally")
    end
  end

  # The sidecar keeps action authorization in memory.  Reconcile it while the
  # local switch is on so a sidecar restart does not require restarting Lich.
  # Do not change @actions_enabled here: only an explicit local command or the
  # initial set_actions request is allowed to engage the local kill switch.
  def self.reconcile_action_registration
    return false unless @actions_enabled
    if @snapshot_generation_rejected
      @actions_enabled = false
      @pending_approval_id = nil
      return false
    end
    return false if Time.now - @last_action_registration_at < ACTION_REGISTRATION_INTERVAL

    @last_action_registration_at = Time.now
    action_request(
      '/v1/actions/control',
      { character: character_name, generation: session_generation, enabled: true }
    )
    true
  rescue => error
    if Time.now - @last_action_registration_error_at > 30
      Lich.log("lab bridge action registration reconciliation failed: #{error.class}: #{error.message}")
      @last_action_registration_error_at = Time.now
    end
    false
  end

  def self.approve_action(action_id, approval_mode = 'manual')
    unless action_id.match?(/\A[0-9a-f]{16}\z/)
      display('invalid action id')
      return
    end
    body = action_request(
      '/v1/actions/approve',
      {
        action_id: action_id,
        character: character_name,
        room_id: room_fingerprint,
        generation: session_generation,
        approval_mode: approval_mode
      }
    )
    @pending_approval_id = nil if @pending_approval_id == action_id
    display("approved (#{approval_mode}) #{body.fetch(:action_id)}: #{action_description(body)}")
  rescue => error
    display("approval failed (#{error.message})")
  end

  def self.safe_action_command?(command)
    text = command.to_s
    return false if FORBIDDEN_ACTIONS.any? { |pattern| pattern.match?(text) }

    SAFE_ACTIONS.any? { |pattern| pattern.match?(text) }
  end

  def self.safe_sequence_command?(command)
    text = command.to_s
    safe_action_command?(text) && SAFE_SEQUENCE_ACTIONS.any? { |pattern| pattern.match?(text) }
  end

  # A sequence may move only objects that Lich can currently prove belong to
  # the admitted character.  GameObj.containers also tracks inspected room and
  # locker containers, so walking every published container would make an
  # external object look like carried inventory.  Begin with the character's
  # inventory and hands, then follow contents only beneath those owned roots.
  def self.owned_inventory_snapshot
    containers = GameObj.containers
    objects = Array(GameObj.inv) + [GameObj.right_hand, GameObj.left_hand].compact
    seen = {}
    parents = Hash.new { |hash, key| hash[key] = [] }
    queue = objects.dup

    until queue.empty?
      object = queue.shift
      object_id = object.id.to_s
      next if object_id.empty? || seen.key?(object_id)

      seen[object_id] = object
      nested = containers[object_id]
      nested = containers[object.id] if nested.nil?
      Array(nested).each do |child|
        child_id = child.id.to_s
        next if child_id.empty?

        parents[child_id] << object_id unless parents[child_id].include?(object_id)
        queue << child unless seen.key?(child_id)
      end
    end

    { objects: seen.values, parents: parents }
  end

  def self.owned_inventory_objects
    owned_inventory_snapshot.fetch(:objects)
  end

  def self.resolve_owned_items(reference, snapshot = owned_inventory_snapshot)
    text = reference.to_s.strip.sub(/\Amy\s+/i, '')
    if (id_match = text.match(/\A#([0-9]+)\z/))
      return snapshot.fetch(:objects).select { |item| item.id.to_s == id_match[1] }
    end

    normalized = normalize_item_name(text)
    return [] if normalized.empty?

    snapshot.fetch(:objects).select do |item|
      [item.noun, item.name, item.full_name].compact.any? do |candidate|
        normalize_item_name(candidate) == normalized
      end
    end
  end

  def self.owned_item_id(reference, snapshot)
    matches = resolve_owned_items(reference, snapshot)
    if matches.empty?
      raise SequenceOwnershipError, "no carried inventory match for #{reference}"
    end
    if matches.length > 1
      raise SequenceOwnershipError, "ambiguous carried inventory match for #{reference}; use an item ID"
    end

    matches.first.id.to_s
  end

  def self.binary_owned_candidates(body, prepositions, snapshot)
    pattern = /\s+(#{prepositions.map { |word| Regexp.escape(word) }.join('|')})\s+/i
    candidates = []
    body.to_enum(:scan, pattern).each do
      match = Regexp.last_match
      left = body[0...match.begin(0)]
      right = body[match.end(0)..]
      next unless explicit_owned_reference?(left) && explicit_owned_reference?(right)

      begin
        candidates << [
          owned_item_id(left, snapshot),
          match[1].downcase,
          owned_item_id(right, snapshot)
        ]
      rescue SequenceOwnershipError
        next
      end
    end
    candidates.uniq
  end

  def self.explicit_owned_reference?(reference)
    reference.to_s.strip.match?(/\A(?:#[0-9]+|my\s+\S)/i)
  end

  def self.validate_owned_sequence_command(command)
    text = command.to_s
    snapshot = owned_inventory_snapshot

    if (put_match = text.match(/\Aput\s+(.+)\z/i))
      candidates = binary_owned_candidates(
        put_match[1],
        %w[in into on under behind],
        snapshot
      ).reject { |item_id, _preposition, destination_id| item_id == destination_id }
      unless candidates.length == 1
        raise SequenceOwnershipError, 'put must identify one carried item and one carried destination'
      end

      return text
    end

    if (crafting_match = text.match(/\A(pour|dip|wave)\s+(.+)\z/i))
      verb = crafting_match[1].downcase
      preposition = { 'pour' => 'on', 'dip' => 'in', 'wave' => 'at' }.fetch(verb)
      candidates = binary_owned_candidates(crafting_match[2], [preposition], snapshot)
      unless candidates.length == 1
        raise SequenceOwnershipError,
              "#{verb} must identify one carried source and one carried target"
      end

      return text
    end

    if (cast_match = text.match(/\Acast\s+at\s+(.+)\z/i))
      reference = cast_match[1]
      unless explicit_owned_reference?(reference)
        raise SequenceOwnershipError, 'cast at requires my ITEM or an exact item ID'
      end
      owned_item_id(reference, snapshot)
      return text
    end

    if (infuse_match = text.match(/\Ainfuse\s+(.+)\z/i))
      reference = infuse_match[1]
      unless explicit_owned_reference?(reference)
        raise SequenceOwnershipError, 'infuse requires my ITEM or an exact item ID'
      end
      owned_item_id(reference, snapshot)
      return text
    end

    if (get_match = text.match(/\A(get|take)\s+(.+)\z/i))
      body = get_match[2]
      candidates = binary_owned_candidates(body, ['from'], snapshot).select do |item_id, _preposition, source_id|
        snapshot.fetch(:parents).fetch(item_id, []).include?(source_id)
      end
      if candidates.length == 1
        return text
      end
      raise SequenceOwnershipError, 'get/take source is not the carried parent' if body.match?(/\s+from\s+/i)

      unless explicit_owned_reference?(body)
        raise SequenceOwnershipError, 'get/take requires my ITEM or an exact item ID'
      end
      owned_item_id(body, snapshot)
      return text
    end

    if (unary_match = text.match(/\A(remove|wear|stow|sheath|gird|open|close)\s+(.+)\z/i))
      reference = unary_match[2]
      unless explicit_owned_reference?(reference)
        raise SequenceOwnershipError, "#{unary_match[1].downcase} requires my ITEM or an exact item ID"
      end
      owned_item_id(reference, snapshot)
      return text
    end

    text
  end

  def self.action_commands(action)
    if action.key?(:commands)
      commands = action.fetch(:commands)
      unless commands.is_a?(Array) && commands.length.between?(2, MAX_SEQUENCE_COMMANDS)
        raise ArgumentError, "sequence must contain 2-#{MAX_SEQUENCE_COMMANDS} commands"
      end
      normalized = commands.map do |command|
        text = command.to_s
        if text.empty? || text.length > 160 || text.match?(/[\x00\r\n]/)
          raise ArgumentError, 'sequence contains an invalid command'
        end
        text
      end
      if normalized.sum(&:length) > MAX_SEQUENCE_LENGTH
        raise ArgumentError, "sequence exceeds #{MAX_SEQUENCE_LENGTH} characters"
      end
      normalized
    else
      [action.fetch(:command).to_s]
    end
  end

  def self.action_description(action)
    commands = action_commands(action)
    return commands.first if commands.length == 1

    commands.each_with_index.map { |command, index| "[#{index + 1}] #{command}" }.join(' -> ')
  rescue
    'invalid action payload'
  end

  def self.sequence_failure_response?(response)
    response == false || SEQUENCE_FAILURE.match?(response.to_s)
  end

  def self.execute_action_sequence(action, commands)
    expected_room = action[:expected_room_id]
    commands.each_with_index do |command, index|
      # Establish capture only after Lich's authoritative RT clocks clear.
      # Otherwise fput may retry a command internally after an RT rejection,
      # and that invisible retry bypasses the per-command inventory handoff.
      waitrt?
      waitcastrt?
      step = index + 1
      unless @actions_enabled
        report_action(action, 'failed', "sequence stopped before step #{step}: local kill switch is off")
        return
      end
      unless action.fetch(:character).casecmp?(character_name)
        report_action(action, 'failed', "sequence stopped before step #{step}: character changed")
        return
      end
      if commands.any? { |candidate| %w[info skills].include?(candidate.downcase) } &&
         action[:generation] != session_generation
        report_action(action, 'failed', "sequence stopped before step #{step}: session generation changed")
        return
      end
      if Time.now.to_f >= action.fetch(:expires_at).to_f
        report_action(action, 'failed', "sequence expired before step #{step}")
        return
      end
      if expected_room && expected_room.to_s != room_fingerprint
        report_action(action, 'failed', "sequence stopped before step #{step}: room changed")
        return
      end
      unless safe_sequence_command?(command)
        report_action(action, 'failed', "sequence step #{step} was rejected locally")
        @actions_enabled = false
        display('sequence rejected locally; kill switch engaged')
        return
      end
      begin
        executable_command = validate_owned_sequence_command(command)
      rescue SequenceOwnershipError => error
        report_action(action, 'failed', "sequence step #{step} ownership check failed: #{error.message}")
        display("sequence ownership check failed at step #{step}/#{commands.length}")
        return
      end

      prepare_inventory_capture(executable_command)
      response = send_sequence_command(executable_command, timeout: 20)
      if sequence_failure_response?(response)
        detail = response == false ? 'no accepted game response' : response.to_s
        report_action(action, 'failed', "sequence stopped at step #{step}: #{detail}")
        display("sequence failed at step #{step}/#{commands.length}: #{command}")
        return
      end
    end
    publish_snapshot(force: true)
    report_action(action, 'completed', "sequence sent #{commands.length}/#{commands.length} commands")
    display("executed sequence [#{action.fetch(:action_id)}]: #{commands.length} commands")
  end

  def self.report_action(action, outcome, detail)
    action_request(
      '/v1/actions/result',
      {
        action_id: action.fetch(:action_id),
        character: character_name,
        generation: session_generation,
        outcome: outcome,
        detail: detail.to_s[0, 500]
      }
    )
  rescue => error
    Lich.log("lab bridge result report failed: #{error.class}: #{error.message}")
  end

  def self.inventory_objects
    owned_inventory_objects
  end

  def self.normalize_item_name(name)
    name.to_s.sub(/\A(?:a|an|some)\s+/i, '').gsub(/\s+/, ' ').strip.downcase
  end

  def self.resolve_exact_items(query)
    if (id_match = query.to_s.strip.match(/\A#([0-9]+)\z/))
      return inventory_objects.select { |item| item.id.to_s == id_match[1] }
    end

    normalized_query = normalize_item_name(query)
    inventory_objects.select do |item|
      [item.name, item.full_name].any? do |candidate|
        normalize_item_name(candidate) == normalized_query
      end
    end
  end

  def self.inspect_exact_item(action, query)
    matches = resolve_exact_items(query)
    if matches.empty?
      display("no exact inventory match for: #{query}")
    else
      matches.each do |item|
        display("item match: id=##{item.id} noun=#{item.noun} name=#{item.name} full_name=#{item.full_name}")
      end
    end
    report_action(action, 'completed', "exact item matches=#{matches.length}")
    display("executed [#{action.fetch(:action_id)}]: inspect item exact")
  end

  def self.diagnose_exact_item(action, spell_number, query)
    matches = resolve_exact_items(query)
    unless matches.length == 1
      detail = "expected one exact inventory match for #{query}, found #{matches.length}"
      report_action(action, 'failed', detail)
      display(detail)
      return
    end

    item = matches.first
    prepared = dothistimeout(
      "prepare #{spell_number}",
      5,
      /Your spell is ready\.|already preparing|You (?:can't|cannot)|unable to prepare/i
    )
    unless prepared =~ /Your spell is ready\./i
      detail = "could not prepare #{spell_number} for exact item ##{item.id}"
      report_action(action, 'failed', detail)
      display(detail)
      return
    end

    diagnostic = capture_diagnostic(
      spell_number.to_s,
      item.id.to_s,
      action.fetch(:action_id),
      item
    ) do
      fput("cast at ##{item.id}")
    end
    outcome = diagnostic[:published] ? 'succeeded' : 'failed'
    detail = if diagnostic[:published]
               "captured #{spell_number} evidence for exact item ##{item.id}"
             else
               "cast #{spell_number} at exact item ##{item.id}; attributable evidence unavailable"
             end
    report_action(action, outcome, detail)
    display("executed [#{action.fetch(:action_id)}]: diagnose item #{spell_number} exact #{query}")
  end

  def self.examine_exact_id(action, method, object_id)
    matches = resolve_exact_items("##{object_id}")
    unless matches.length == 1
      detail = "expected one live inventory item ##{object_id}, found #{matches.length}"
      report_action(action, 'failed', detail)
      display(detail)
      return
    end

    command = "#{method} ##{object_id}"
    prepare_inventory_capture(command)
    diagnostic = capture_diagnostic(
      method,
      object_id,
      action.fetch(:action_id),
      matches.first
    ) { fput(command) }
    outcome = diagnostic[:published] ? 'succeeded' : 'failed'
    detail = if diagnostic[:published]
               "captured #{method} evidence for exact item ##{object_id}"
             else
               "sent #{method} for exact item ##{object_id}; attributable evidence unavailable"
             end
    report_action(action, outcome, detail)
    display("executed [#{action.fetch(:action_id)}]: #{command}")
  end

  def self.inspect_ready_weapon_links(action)
    path = "/tmp/lab-ready-links-#{Process.pid}.xml"
    File.delete(path) if File.exist?(path)
    @raw_capture_path = path
    @raw_capture_until = Time.now + 3
    fput('ready weapon set')
    sleep 1
    @raw_capture_until = Time.at(0)
    @raw_capture_path = nil
    report_action(action, 'completed', "raw ready links captured at #{path}")
    display('captured READY link metadata locally for inspection')
    display("executed [#{action.fetch(:action_id)}]: inspect ready weapon links")
  rescue => error
    @raw_capture_until = Time.at(0)
    @raw_capture_path = nil
    raise error
  end

  # Commands sent with fput from this script do not traverse another script's
  # UpstreamHook.  Explicitly notify the inventory knowledge seam before an
  # item examination or Scroll Infusion operation so its downstream response
  # can be attributed to the exact physical dossier, including duplicate-looking
  # objects selected by ID.
  def self.prepare_inventory_capture(command)
    normalized = command.to_s
    knowledge = normalized.match(
      /\A(?:assess|inspect|analyze|look|read|appraise|recall)\s+(.+)\z/i
    )
    if knowledge
      return false unless defined?(LabInventory) && LabInventory.respond_to?(:begin_capture)

      LabInventory.begin_capture(normalized, knowledge[1])
      return true
    end

    scroll_operation = normalized.match?(
      /\A(?:wave\s+.+?\s+at\s+.+|infuse\s+.+)\z/i
    )
    return false unless scroll_operation
    return false unless defined?(LabInventory) && LabInventory.respond_to?(:begin_scroll_operation_capture)

    LabInventory.begin_scroll_operation_capture(normalized)
    true
  rescue => error
    Lich.log("lab bridge inventory capture notification failed: #{error.class}: #{error.message}")
    false
  end

  # Opted-in Quick controllers retain exact native Script/runtime identities.
  # These are bridge-local lifecycle records, never a public global registry.
  # Lich reloads a script into a fresh script module. Process globals are the
  # narrow persistence seam that lets a player acknowledge an already-finished
  # unsafe handoff after restarting only lab-bridge; no active authority or
  # lease is reconstructed from this ledger.
  def self.bind_controlled_run_store
    $lab_controlled_run_mutex ||= Mutex.new
    $lab_controlled_runs ||= {}
    @controlled_run_mutex = $lab_controlled_run_mutex
    @controlled_runs = $lab_controlled_runs
  end

  bind_controlled_run_store

  def self.controlled_action_authority(action_id)
    request(:post, '/v1/actions/status', { action_id: action_id }, authorized: true, read_timeout: 0.2)
  end

  def self.quick_runtime_status(run)
    value = run[:runtime]&.status || run[:terminal_status]
    quick_status_payload(value)
  end

  def self.controlled_refuge_handoff?(controller)
    controller && %w[quick_refuge controller_refuge].include?(controller.safe_handoff['kind'])
  end

  def self.controlled_runtime(instance)
    runtime = instance.controller_runtime if instance&.respond_to?(:controller_runtime)
    return runtime if runtime
    runtime = instance.quick_combat_runtime if instance&.respond_to?(:quick_combat_runtime)
    return runtime if runtime

    nil
  end

  def self.controlled_terminal_status(instance)
    status = instance.controller_result if instance&.respond_to?(:controller_result)
    return status if status
    status = instance.quick_combat_result if instance&.respond_to?(:quick_combat_result)
    return status if status

    nil
  end

  # Presentation only: retain summaries/identity and newest outcome records
  # within the existing result budget. Never mutate the owner's cached status
  # or turn transport completion into evidence that game effects occurred.
  def self.quick_trial_result_summary(result)
    return {} unless result.is_a?(Hash)
    creature = result[:creature]
    creature_label = if creature.is_a?(Hash)
                       creature[:name] || creature[:noun] || creature[:id]
                     else
                       creature
                     end
    {
      index: result[:index], routine: result[:routine], target_id: result[:target_id],
      creature: creature_label, outcome: result[:outcome],
      actions: Array(result[:actions]).length, samples: Array(result[:samples]).length,
      elapsed_seconds: result[:elapsed_seconds]
    }.reject { |_key, value| value.nil? }
  end

  def self.quick_status_payload(value)
    return {} unless value.is_a?(Hash)
    copy = JSON.parse(JSON.generate(value), symbolize_names: true)
    observations = copy[:observations]
    projected = false
    objective = copy[:objective]
    if objective.is_a?(Hash)
      results = objective.delete(:results)
      if results.is_a?(Array)
        objective[:results_count] = results.length
        copy[:trial_results] = results.map { |result| quick_trial_result_summary(result) }
        projected = true
      end
      if objective[:active].is_a?(Hash)
        objective[:active] = quick_trial_result_summary(objective[:active])
        projected = true
      end
    end
    work = copy[:work_result]
    if work.is_a?(Hash) && work[:observations].is_a?(Array)
      work[:observation_transport] = { omitted_entries: work.delete(:observations).length,
                                       observations_source: 'runtime.observations' }
      projected = true
    end
    if observations.is_a?(Array)
      observations.each do |entry|
        next unless entry.is_a?(Hash)
        data = entry[:data]
        if data.is_a?(Hash) || data.is_a?(Array)
          data = JSON.generate(data)
          if data.length > 4000
            entry[:data_omitted_characters] = data.length - 4000
            data = data[0, 4000]
            entry[:data_presentation] = 'json-prefix'
          else
            entry[:data_presentation] = 'json'
          end
          entry[:data] = data
          projected = true
        end
        command = entry[:command]
        if command.is_a?(Array)
          # An array inside an outcome exceeds the event envelope's depth cap.
          # JSON text preserves grouping without creating executable commands.
          command = JSON.generate(command)
          entry[:command_presentation] = 'json'
          projected = true
        end
        next unless command.is_a?(String)
        if command.length > 4000
          entry[:command_omitted_characters] = command.length - 4000
          command = command[0, 4000]
          projected = true
        end
        entry[:command] = command
      end
    end
    encoded = JSON.generate(copy)
    return copy if !projected && encoded.bytesize <= 32_768

    omitted = 0
    loop do
      if observations.is_a?(Array)
        copy[:observation_transport] = {
          omitted_entries: omitted,
          retained_sequence_range: { first: observations.first&.dig(:sequence), last: observations.last&.dig(:sequence) }
        }
      end
      return copy if JSON.generate(copy).bytesize <= 32_768
      raise LabControllerControls::Invalid, 'Controlled status summary exceeds result limit' unless observations.is_a?(Array) && !observations.empty?
      observations.shift
      omitted += 1
    end
  end

  def self.quick_runtime_terminal?(run)
    %w[completed stopped].include?(quick_runtime_status(run)[:state].to_s)
  end

  # Bigshot alone resolves profile boundaries. Only its exact child's published
  # proof can authorize following player movement; LAB never traverses the map.
  def self.controlled_area_status?(status)
    area = status[:area]
    area.is_a?(Hash) && area[:kind].to_s == 'profile' && area.key?(:room_id) && [true, false].include?(area[:in_bounds]) &&
      (area[:room_id].nil? || area[:room_id].is_a?(Integer)) &&
      (area[:in_bounds] == false || area[:room_id].is_a?(Integer)) &&
      area[:start_room_id].is_a?(Integer) && area[:room_count].is_a?(Integer) && area[:room_count].positive? &&
      area[:boundary_room_ids].is_a?(Array) && area[:boundary_room_ids].all? { |id| id.is_a?(Integer) }
  end

  def self.controlled_area_in_bounds?(run, status = quick_runtime_status(run))
    return false unless run[:controller].safe_handoff['kind'] == 'quick_area'
    area = status[:area]
    controlled_area_status?(status) && area[:in_bounds] == true &&
      area[:room_id].is_a?(Integer) && area[:room_id].to_s == room_fingerprint
  end

  def self.controlled_monitor_room_available?(run)
    if controlled_refuge_handoff?(run[:controller])
      refuge = quick_runtime_status(run)[:refuge]
      return refuge.is_a?(Hash) && refuge[:room_id] == run[:controller].safe_handoff['room_id'].to_i &&
        %w[outbound working recovering returning finished].include?(refuge[:phase].to_s)
    end
    return controlled_run_room_available?(run) unless run[:controller].safe_handoff['kind'] == 'quick_area'
    status = quick_runtime_status(run)
    # Cached publication can lag player movement while the owner unwinds work.
    # Native --area profile guards every send. Stale proof denies controls, but
    # does not itself revoke the entire run before its owner can publish again.
    controlled_area_status?(status) && status[:area][:in_bounds] == true &&
      (%w[watch assist seek].include?(status[:mode].to_s) ||
        (%w[clear trial].include?(status[:mode].to_s) && run[:action][:expected_room_id].to_s == room_fingerprint))
  end

  def self.controlled_run_room_available?(run)
    return controlled_monitor_room_available?(run) if controlled_refuge_handoff?(run[:controller])
    return run[:action][:expected_room_id].to_s == room_fingerprint unless run[:controller].safe_handoff['kind'] == 'quick_area'
    status = quick_runtime_status(run)
    %w[watch assist seek clear trial].include?(status[:mode].to_s) && controlled_area_in_bounds?(run, status) &&
      (%w[watch assist seek].include?(status[:mode].to_s) || run[:action][:expected_room_id].to_s == room_fingerprint)
  end

  def self.controlled_script_names(instance)
    scripts = Array(Script.running)
    scripts.concat(Array(Script.hidden)) if Script.respond_to?(:hidden)
    children = instance.respond_to?(:child_scripts) ? instance.child_scripts : []
    scripts.filter_map do |script|
      next unless script.respond_to?(:name)
      name = script.name.to_s.downcase
      # Native start_child adopts before releasing the worker. vars[0] is the
      # complete argument string; remaining entries are its parsed arguments.
      # Only this exact direct definitions-loader child belongs to Quick's
      # inventory work. A foreign/sibling loader or ordinary eLoot still conflicts.
      next if name == 'eloot' && children.any? { |child| child.equal?(script) } &&
              script.respond_to?(:vars) && script.vars == ['--load-room-api', '--load-room-api']
      # Supervised refuge transit delegates to native go2. Only the exact
      # direct child pinned by the active travel adapter shares this ownership;
      # another go2, a stale child entry, or an unreadable predicate still fails
      # the caller's local availability check. Names alone never grant transit.
      next if name == 'go2' && children.any? { |child| child.equal?(script) } &&
              ((instance.respond_to?(:controller_refuge_travel_child?) &&
                instance.controller_refuge_travel_child?(script) == true) ||
               (instance.respond_to?(:quick_refuge_travel_child?) &&
                instance.quick_refuge_travel_child?(script) == true))
      name unless name.empty?
    end.uniq
  end

  def self.controlled_local_available?(run, action, check_room: true)
    return false unless @running && @actions_enabled && !@snapshot_generation_rejected
    return false unless action[:generation] == session_generation && action[:character].to_s.casecmp?(character_name)
    return false unless @controlled_run_mutex.synchronize { @controlled_runs[run[:controller].name].equal?(run) }
    instance = run[:instance]
    return false unless instance && instance.running? && !instance.stopping?
    return false unless controlled_runtime(instance).equal?(run[:runtime])
    return false if check_room && (action[:expected_room_id].to_s != room_fingerprint || !controlled_run_room_available?(run))
    scripts = controlled_script_names(instance)
    allowed = run[:controller].control_owner_scripts.map(&:downcase)
    excluded = run[:controller].owner_scripts.map(&:downcase) - allowed
    return false unless (scripts & excluded).empty?
    owners = script_owners(scripts)
    run[:controller].lanes.all? { |lane| allowed.include?(owners[lane.to_sym].to_s.downcase) }
  rescue StandardError
    false
  end

  def self.cooperatively_close_controlled_run(run)
    run[:binding]&.close
    runtime = run[:runtime]
    runtime ||= controlled_runtime(run[:instance])
    return if !runtime || run[:stop_requested]
    status = runtime.status
    # Movement during admitted retreat may finish within the cleanup budget;
    # revoked launch authority still requests stop, including during retreat.
    return if run[:failure] != 'controller_authority_lost' && (status[:retreat_pending] || status[:reason].to_s == 'retreat_pending')
    return if %w[completed stopped].include?(status[:state].to_s)
    response = runtime.request('stop')
    run[:stop_requested] = response.is_a?(Hash) && response[:accepted] == true
  rescue StandardError
    run[:failure] ||= 'cooperative_stop_unavailable'
  end

  # Read native state now, not a prior HTTP snapshot. Empty hands are known only
  # when the native hand readers exist; unknown item identity is not restoration.
  def self.controlled_refuge_hands!(run, expected_generation: run[:action][:generation])
    state = snapshot_state
    raise LabControllerControls::Invalid, 'current character does not match the controlled action' unless state[:character].to_s.casecmp?(run[:action][:character])
    raise LabControllerControls::Invalid, 'current session generation does not match the controlled action' unless state[:generation] == session_generation && state[:generation] == expected_generation
    raise LabControllerControls::Invalid, 'current room is not the configured controller refuge' unless state.dig(:room, :id).to_s == run[:controller].safe_handoff['room_id'].to_i.to_s
    raise LabControllerControls::Invalid, 'character must be alive before a controlled outing starts' unless state[:dead] == false && state.dig(:vitals, :health, :current).to_f.positive?
    raise LabControllerControls::Invalid, 'character must be unstunned before a controlled outing starts' unless state[:stunned] == false
    raise LabControllerControls::Invalid, 'character must be standing before a controlled outing starts' unless XMLData.indicator['IconSTANDING'] == 'y'
    raise LabControllerControls::Invalid, 'native hand readers are unavailable' unless GameObj.respond_to?(:right_hand) && GameObj.respond_to?(:left_hand)
    hands = state[:hands]
    raise LabControllerControls::Invalid, 'both hand identities must be known before a controlled outing starts' unless hands.is_a?(Hash) && %i[right left].all? { |side| hands.key?(side) }
    hands.transform_values do |item|
      next nil if item.nil?
      raise LabControllerControls::Invalid, 'held-item identity must be known before Quick starts' unless item.is_a?(Hash) && item[:id].to_s.match?(/\A[0-9]+\z/)
      item[:id].to_s
    end
  end

  def self.controlled_refuge_hands(run, expected_generation: run[:action][:generation])
    controlled_refuge_hands!(run, expected_generation: expected_generation)
  rescue StandardError
    nil
  end

  def self.controlled_refuge_restored?(run, expected_generation: run[:action][:generation])
    hands = controlled_refuge_hands(run, expected_generation: expected_generation)
    hands && hands == run[:start_hands] && script_owners(live_scripts).values.compact.empty?
  end

  def self.unresolved_controlled_handoff?
    runs = @controlled_run_mutex.synchronize { @controlled_runs.values.dup }
    runs.any? do |previous|
      next false unless previous[:unsafe_handoff]
      restored = previous[:instance]&.join(0) && controlled_refuge_restored?(previous)
      if restored
        @controlled_run_mutex.synchronize do
          @controlled_runs.delete(previous[:controller].name) if @controlled_runs[previous[:controller].name].equal?(previous)
        end
      end
      !restored
    end
  end

  # Local player acknowledgement, deliberately absent from broker capabilities.
  # Retain the original run/result for audit and receipt retry until superseded.
  # No movement, equipment commands, child cancellation or authority renewal.
  def self.recover_controlled_handoff(action_id = nil, confirm: false)
    @execution_mutex.synchronize do
      runs = @controlled_run_mutex.synchronize { @controlled_runs.values.dup }
      if action_id.nil?
        pending = runs.select { |run| run[:unsafe_handoff] && run[:action][:character].to_s.casecmp?(character_name) }
        display('no unresolved native controller handoffs') if pending.empty?
        pending.each do |run|
          display("unresolved controller #{run[:action][:action_id]}: refuge #{run[:controller].safe_handoff['room_id']}; after restoring equipment, use ;lab recover #{run[:action][:action_id]} confirm")
        end
        return
      end
      raise ArgumentError, 'use ;lab recover RUN_ID confirm' unless confirm == true && action_id.match?(/\A[0-9a-f]{16}\z/)
      run = runs.find { |candidate| candidate[:action][:action_id] == action_id }
      raise ArgumentError, 'no matching unresolved or acknowledged controller run' unless run && (run[:unsafe_handoff] || run[:operator_recovered])
      raise ArgumentError, 'recovery requires a supervised refuge run' unless controlled_refuge_handoff?(run[:controller])
      raise ArgumentError, 'owned controller child or monitor has not exited' unless run[:instance]&.join(0) && run[:monitor]&.join(0)
      generation = session_generation
      hands = controlled_refuge_hands(run, expected_generation: generation)
      unless hands && hands == run[:start_hands] && script_owners(live_scripts).values.compact.empty?
        raise ArgumentError, 'recovery requires the same character, configured refuge, standing survival, original hands and released owners'
      end
      publish_snapshot(force: true)
      # A replacement LAB instance must not confirm a check begun by this one.
      raise ArgumentError, 'session changed during recovery' unless generation == session_generation
      receipt = { controller: run[:controller].name, action_id: action_id,
                  previous_generation: run[:action][:generation], operator_confirmed: true,
                  room_id: run[:controller].safe_handoff['room_id'].to_s, hands: hands }
      unless publish_event('controller_recovery', 'Player verified safe recovery; original test result unchanged', receipt)
        raise ArgumentError, 'recovery receipt was not acknowledged; lock retained, retry the same command'
      end
      unless controlled_refuge_restored?(run, expected_generation: generation)
        raise ArgumentError, 'handoff changed during acknowledgement; lock retained'
      end
      @controlled_run_mutex.synchronize do
        raise ArgumentError, 'run or session changed during recovery' unless @controlled_runs[run[:controller].name].equal?(run) && generation == session_generation
        run[:unsafe_handoff] = false
        run[:operator_recovered] = true
      end
      display("recovery acknowledged for #{action_id}; original test remains failed. LAB rechecks current state before another test.")
    end
  rescue StandardError => error
    display("recovery refused: #{error.message}")
  end

  def self.request_controlled_return(run)
    return if run[:return_requested] || !run[:lease]&.return_requested?
    response = run[:runtime].request('stop', valid: -> { run[:lease].valid? })
    raise LabControllerControls::Invalid, 'controlled runtime refused authorized return' unless response.is_a?(Hash) && response[:accepted] == true
    run[:return_requested] = true
  end

  def self.controlled_terminal_result(run, joined)
    status = quick_runtime_status(run)
    successful_exit = joined && run[:instance].completed_successfully? && !run[:instance].exit_error
    reason = status[:reason].to_s
    complete = status[:state].to_s == 'completed' || (status[:state].to_s == 'stopped' && %w[retreated already_at_refuge].include?(reason))
    prefix = run[:controller]&.safe_handoff&.fetch('kind', nil) == 'controller_refuge' ? 'controller' : 'quick'
    code = !joined ? 'cleanup_incomplete' : run[:failure] || (!successful_exit ? 'script_failed' : "#{prefix}_#{reason.empty? ? 'unverified' : reason}")
    recovery = nil
    if controlled_refuge_handoff?(run[:controller])
      work = status[:work_result]
      complete = work.is_a?(Hash) && (work[:state].to_s == 'completed' ||
        (work[:state].to_s == 'stopped' && %w[retreated already_at_refuge].include?(work[:reason].to_s)))
      refuge = status[:refuge]
      recovery = (joined && %w[completed stopped].include?(status[:state].to_s) && refuge.is_a?(Hash) && refuge[:room_id] == run[:controller].safe_handoff['room_id'].to_i &&
        refuge[:phase].to_s == 'finished' && refuge[:returned] == true && refuge[:equipment_restored] == true &&
        controlled_refuge_restored?(run)) == true
      run[:unsafe_handoff] = recovery != true
      code = 'unsafe_handoff' unless recovery
    end
    { ok: successful_exit && complete && !run[:failure], code: code.to_s[0, 128],
      message: "Controlled runtime ended: #{code}. Game effects and safe handoff require separate evidence."[0, 500],
      details: { run_id: run[:action][:action_id], runtime: status, cleanup_complete: joined,
                 effects_verified: false, recovery_complete: recovery } }.tap { |result| result[:ok] = false if recovery == false }
  rescue StandardError
    run[:unsafe_handoff] = true if controlled_refuge_handoff?(run[:controller])
    { ok: false, code: 'malformed_runtime_result', message: 'Controlled runtime result unavailable.', details: { cleanup_complete: joined } }
  end

  def self.monitor_controlled_run(run, cleanup_timeout: 3)
    Thread.new do
      cleanup_deadline = nil
      loop do
        break if run[:instance].join(0)
        terminal = quick_runtime_terminal?(run)
        if run[:failure] || terminal || !run[:instance].running?
          run[:binding]&.close
        elsif !run[:lease]&.refresh
          # Refresh includes local child liveness. The owner may have published
          # its terminal result and exited during the authority request. Close
          # admission, but do not replace that result with a false revocation.
          terminal = quick_runtime_terminal?(run)
          run[:binding]&.close
          run[:failure] = 'controller_authority_lost' unless terminal
        elsif !controlled_monitor_room_available?(run)
          state = quick_runtime_status(run)
          # An explicitly admitted retreat retains its separate refuge authority;
          # controls close while cleanup runs, without claiming an area handoff.
          unless state[:retreat_pending] || state[:reason].to_s == 'retreat_pending'
            run[:failure] = run[:controller].safe_handoff['kind'] == 'quick_area' ? 'controller_area_unverified' : 'controller_room_changed'
          end
          run[:binding]&.close
        else
          run[:binding].refresh
          request_controlled_return(run)
        end
        if run[:failure] || terminal || !run[:binding]&.open?
          cooperatively_close_controlled_run(run) if run[:failure]
          cleanup_deadline ||= Process.clock_gettime(Process::CLOCK_MONOTONIC) + cleanup_timeout
          break if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= cleanup_deadline
        end
        sleep 0.05
      end
      run[:binding]&.close
      joined = !!run[:instance].join(0)
      result = controlled_terminal_result(run, joined)
      attach_combat_report(run, result)
      run[:result] = result
      display('Controlled outing ended without verified refuge/equipment handoff. Resolve it before another agent test.') if run[:unsafe_handoff]
      # Do not relabel an old run's evidence as a replacement session.
      if run[:action][:generation] == session_generation && run[:action][:character].to_s.casecmp?(character_name)
        set_script_status(run[:controller].script, "#{result[:code]}:#{run[:action][:action_id]}")
        publish_snapshot(force: true)
        acknowledged = publish_controller_result(run[:controller], run[:action][:action_id], result)
        unless acknowledged
          # publish_event deliberately reports transport/validation rejection as
          # false. A locally safe result is not complete until SessionHub has
          # accepted its action-attributed evidence, so retain the exact run for
          # explicit player recovery instead of silently releasing exclusion.
          run[:result_publication_failed] = true
          run[:unsafe_handoff] = true
          display("Controller result for #{run[:action][:action_id]} was not acknowledged; safe handoff remains locked. Use ;lab recover #{run[:action][:action_id]} confirm after verifying refuge and equipment.")
        end
      end
    rescue StandardError => error
      run[:failure] ||= 'controller_monitor_failed'
      run[:unsafe_handoff] = true if controlled_refuge_handoff?(run[:controller])
      cooperatively_close_controlled_run(run)
      run[:result] = { ok: false, code: 'controller_monitor_failed',
        message: 'Controller supervision failed; safe handoff remains unverified.',
        details: { run_id: run[:action][:action_id], recovery_complete: false, effects_verified: false } }
      display('Controller supervisor failed; refuge/equipment handoff is unresolved. Do not start another agent test.') if run[:unsafe_handoff]
      if run[:action][:generation] == session_generation && run[:action][:character].to_s.casecmp?(character_name)
        publish_controller_result(run[:controller], run[:action][:action_id], run[:result])
      end
      Lich.log("lab controlled monitor failed: #{error.class}") if defined?(Lich)
    ensure
      run[:combat_capture]&.close
      run[:binding]&.close
      # A missing/incomplete join retains exclusion; never release by name.
      if run[:instance]&.join(0) && !run[:unsafe_handoff]
        @controlled_run_mutex.synchronize { @controlled_runs.delete(run[:controller].name) if @controlled_runs[run[:controller].name].equal?(run) }
      end
    end
  end

  # Inspect the trusted local script selected by Lich before spawning it. This
  # compatibility declaration prevents historical permissive Quick parsers from
  # ignoring our private selector; it is not a sandbox or hostile-code proof.
  def self.supervised_controller_supported?(script)
    return false unless Script.respond_to?(:__find_script_file, true)
    relative = Script.__send__(:__find_script_file, script)
    root = defined?(SCRIPT_DIR) ? SCRIPT_DIR : $script_dir
    return false unless relative.is_a?(String) && root.is_a?(String)
    markers = File.foreach(File.join(root, relative)).filter_map do |line|
      line[/\A    (SUPERVISED_CONTROLLER_PROTOCOL|SUPERVISED_START_PROTOCOL|REFUGE_START_PROTOCOL) = 1\r?\n?\z/, 1]
    end
    markers.include?('REFUGE_START_PROTOCOL') &&
      (markers.include?('SUPERVISED_CONTROLLER_PROTOCOL') || markers.include?('SUPERVISED_START_PROTOCOL'))
  rescue SystemCallError, IOError
    false
  end


  class << self
    alias supervised_quick_supported? supervised_controller_supported?
  end

  def self.launch_controlled_controller(action, match, startup_timeout: 3)
    controller = match.controller
    run = { controller: controller, action: action.transform_values { |value| value.is_a?(String) ? value.dup.freeze : value }.freeze,
      spawn_attempted: false, preflight_receipt_allowed: false }
    unless controlled_refuge_handoff?(controller)
      raise LabControllerControls::Invalid, 'controlled launch requires a verified refuge handoff'
    end
    raise LabControllerControls::Invalid, 'previous controller has unresolved unsafe handoff' if unresolved_controlled_handoff?
    run[:preflight_receipt_allowed] = true
    deadline = action[:controller_deadline]
    raise LabControllerControls::Invalid, 'controlled launch requires an operation deadline within 300 seconds' unless deadline.is_a?(Numeric) && deadline.finite? && (deadline - Time.now.to_f).between?(0.001, 300)
    raise LabControllerControls::Invalid, 'controlled launch requires exact current session and room' unless
      action[:generation] == session_generation && action[:expected_room_id].to_s == room_fingerprint && room_fingerprint != 'unknown'
    raise LabControllerControls::Invalid, 'native child lifecycle unavailable' unless Script.respond_to?(:start_child) && Script.current
    unless supervised_controller_supported?(controller.script) && !match.script_args.include?('--supervised-')
      raise LabControllerControls::Invalid, 'controlled launch requires supervised controller startup and refuge protocols v1'
    end
    observed = controlled_action_authority(action.fetch(:action_id))
    raise LabControllerControls::Invalid, 'controlled launch was revoked or replaced' unless
      %i[action_id character generation command expected_room_id controller_deadline].all? { |key| observed[key] == action[key] } &&
      observed[:status] == 'dispatched' && observed[:stop_requested] == false && observed[:return_requested] == false
    # Fix both restrictions before the child can execute, not after publication.
    monotonic_deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + (deadline - Time.now.to_f)
    reserve = controller.safe_handoff['return_seconds']
    work_deadline, cleanup_deadline = monotonic_deadline - reserve - 12, monotonic_deadline - reserve - 2
    raise LabControllerControls::Invalid, 'insufficient time for controlled startup' unless work_deadline > Process.clock_gettime(Process::CLOCK_MONOTONIC)
    window = format('%.9f,%.9f', work_deadline, cleanup_deadline)
    arguments = "#{match.script_args} --supervised-start-v1 #{window} --supervised-refuge-v1 #{controller.safe_handoff['room_id'].to_i},#{format('%.9f', monotonic_deadline - 2)}"
    run[:start_hands] = controlled_refuge_hands!(run)
    @controlled_run_mutex.synchronize do
      previous = @controlled_runs[controller.name]
      if previous && (!previous[:instance] || !previous[:instance].join(0))
        run[:preflight_receipt_allowed] = false
        raise LabControllerControls::Invalid, 'previous controlled child cleanup is incomplete'
      end
      @controlled_runs[controller.name] = run
    end
    run[:spawn_attempted] = true
    instance = Script.start_child(controller.script, arguments, { quiet: true })
    raise LabControllerControls::Invalid, 'controlled child did not start' unless instance
    run[:instance] = instance
    raise LabControllerControls::Invalid, 'native child lifecycle unavailable' unless %i[join running? stopping? completed_successfully? exit_error].all? { |name| instance.respond_to?(name) }
    startup_deadline = [Time.now.to_f + startup_timeout, deadline].min
    loop do
      run[:runtime] = controlled_runtime(instance)
      break if run[:runtime]
      if controlled_terminal_status(instance)
        run[:terminal_status] = controlled_terminal_status(instance)
        break if quick_runtime_terminal?(run)
      end
      raise LabControllerControls::Invalid, 'controlled runtime publication was not observed' if instance.join(0) || Time.now.to_f >= startup_deadline
      sleep 0.01
    end
    raise LabControllerControls::Invalid, 'controlled runtime exited before supervised activation' unless run[:runtime]
    run[:lease] = LabControllerControls::Lease.new(action: run[:action], deadline: deadline,
      available: ->(request) { controlled_local_available?(run, request, check_room: false) },
      authority: method(:controlled_action_authority), clock: -> { Time.now.to_f })
    run[:binding] = LabControllerControls::Binding.new(controller: controller, launch: run[:action], instance: instance,
      available: ->(request) { run[:lease].valid? && controlled_local_available?(run, request) },
      authority: method(:controlled_action_authority))
    run[:binding].bind(instance, run[:runtime])
    raise LabControllerControls::Invalid, 'controlled launch authority unavailable' unless run[:lease].refresh
    run[:combat_capture] = start_combat_capture(run)
    run[:monitor] = monitor_controlled_run(run)
    unless run[:runtime].respond_to?(:activate_supervised) &&
           run[:runtime].activate_supervised(valid: -> { run[:lease].valid? })
      raise LabControllerControls::Invalid, 'controlled runtime refused supervised activation'
    end
    set_script_status(controller.script, "starting:#{action[:action_id]}")
    publish_snapshot(force: true)
    report_action(action, 'completed', 'Exact controlled child and runtime bound; terminal result remains unverified.')
    run
  rescue StandardError => error
    if run
      run[:failure] = 'controlled_startup_failed'
      # A child which has not advertised its runtime cannot consume cooperative
      # controls. Native lifecycle cancellation sets stopping? synchronously;
      # compatible Quick startup/guards refuse that exact owner before sending.
      # Never stop a successor by script name, and never call this extraction.
      if run[:instance] && !run[:runtime] && run[:instance].respond_to?(:kill)
        run[:instance].kill(async: true)
        run[:failure] = 'forced_startup_cancelled'
      end
      cooperatively_close_controlled_run(run)
      run[:monitor] ||= monitor_controlled_run(run) if run[:instance]&.respond_to?(:join)
      @controlled_run_mutex.synchronize { @controlled_runs.delete(controller.name) if @controlled_runs[controller.name].equal?(run) && !run[:instance] }
      if run[:preflight_receipt_allowed] && !run[:spawn_attempted]
        result = { ok: false, code: 'controlled_start_rejected',
          message: "Controlled startup rejected before child launch: #{error.class}: #{error.message}",
          details: { run_id: action.fetch(:action_id), child_started: false,
            cleanup_complete: true, effects_verified: false } }
        begin
          set_script_status(controller.script, "controlled_start_rejected:#{action.fetch(:action_id)}")
          publish_snapshot(force: true)
          publish_controller_result(controller, action.fetch(:action_id), result)
        rescue StandardError => publish_error
          Lich.log("lab controlled preflight result failed: #{publish_error.class}") if defined?(Lich)
        end
      end
    end
    report_action(action, 'failed', "Controlled startup failed: #{error.class}: #{error.message}")
    nil
  end

  # Optional evidence only. Never enable a recorder/tracker, replace a named
  # subscription, send commands, or let reporting fail controller supervision.
  def self.start_combat_capture(run)
    return unless defined?(Lich::Gemstone::Combat::Recorder::RECEIPT_PROTOCOL) &&
                  Lich::Gemstone::Combat::Recorder::RECEIPT_PROTOCOL == 1
    context = Lich::Gemstone::Combat::Tracker.observation_context
    return unless context && context[:character].to_s.casecmp?(run[:action][:character])
    LabCombatReport::Capture.new(character: run[:action][:character], context: context,
      database: File.join(DATA_DIR, XMLData.game, XMLData.name, 'combat_stats.db'),
      observers: Lich::Gemstone::Combat::Observers)
  rescue StandardError
    nil
  end

  def self.attach_combat_report(run, result)
    raw = run[:runtime]&.status || run[:terminal_status]
    trials = raw.is_a?(Hash) ? raw.dig(:objective, :results) : nil
    report = if run[:combat_capture]
               run[:combat_capture].report(trials: trials, safe: result.dig(:details, :recovery_complete) == true)
             else
               LabCombatReport.unavailable('recorder_receipts_unsupported')
             end
    result[:details][:combat_report_json] = JSON.generate(report)
  rescue StandardError
    result[:details][:combat_report_json] = JSON.generate(LabCombatReport.unavailable('report_failed')) if result[:details].is_a?(Hash)
  end

  def self.execute_controlled_action(action, match)
    raise LabControllerControls::Invalid, 'agent controls require a verified refuge configuration' unless controlled_refuge_handoff?(match.controller)
    run = @controlled_run_mutex.synchronize { @controlled_runs[match.controller.name] }
    raise LabControllerControls::Invalid, 'no exact controlled runtime is bound' unless run && run[:binding]
    result = run[:binding].request(action: action, match: match)
    result[:details][:status] = quick_status_payload(result[:details][:status])
    publish_controller_result(match.controller, action.fetch(:action_id), result)
    report_action(action, 'sent_unverified', result[:message])
  rescue StandardError => error
    report_action(action, 'failed', "Control rejected: #{error.class}: #{error.message}")
  end

  def self.execute_controller_action(broker_action, match)
    controller = match.controller
    controller_action = match.action
    execution_id = broker_action.fetch(:action_id).to_s
    unless controller.characters.any? { |name| name.casecmp?(character_name) }
      report_action(
        broker_action,
        'failed',
        "#{controller.name} controller is unavailable for #{character_name}"
      )
      return
    end

    if controller.test_suite
      execute_test_controller(broker_action, match)
      return
    end

    case controller_action.kind
    when 'control'
      execute_controlled_action(broker_action, match)
    when 'launch'
      if controller.script == 'bigshot' && match.script_args.split.first.to_s.casecmp?('quick') &&
          (controller.control_owner_scripts.empty? || controller.safe_handoff['kind'] != 'quick_refuge')
        report_action(broker_action, 'failed', 'Agent Bigshot Quick requires native controls and quick_refuge safe start/return configuration.')
        return
      end
      owners = controller.owner_scripts.select { |name| Script.running?(name) }
      unless owners.empty?
        report_action(
          broker_action,
          'failed',
          "another controller owner is already running: #{owners.join(', ')}"
        )
        return
      end
      unless controller.control_owner_scripts.empty?
        launch_controlled_controller(broker_action, match)
        return
      end
      clear_controller_result(controller)
      set_controller_signal(controller, false) if controller.signal_global
      set_script_status(controller.script, "starting:#{execution_id}")
      unless launch_controller(controller, controller_action, match.script_args)
        set_script_status(controller.script, "failed:#{execution_id}")
        publish_snapshot(force: true)
        report_action(broker_action, 'failed', "#{controller.script} did not start")
        return
      end
      monitor_controller(controller, execution_id: execution_id)
      publish_snapshot(force: true)
      report_action(
        broker_action,
        'completed',
        "#{controller.script} started; outcome requires attributed controller result"
      )
      display("#{controller.name} [#{execution_id}] started")
    when 'stop'
      Script.kill(controller.script) if Script.running?(controller.script)
      set_script_status(controller.script, 'stopped')
      publish_snapshot(force: true)
      report_action(broker_action, 'completed', "#{controller.script} stopped")
    when 'signal'
      unless Script.running?(controller.script)
        report_action(broker_action, 'failed', "no #{controller.script} is running")
        return
      end
      set_controller_signal(controller, true)
      set_script_status(controller.script, 'return_requested')
      publish_snapshot(force: true)
      report_action(
        broker_action,
        'completed',
        "signal delivered; #{controller.script} retains ownership until safe handoff"
      )
    when 'status'
      status = Script.running?(controller.script) ? 'running' : 'stopped'
      result = normalized_controller_result(
        controller,
        fallback_code: 'no_result',
        fallback_message: 'no completed controller result'
      )
      set_script_status(controller.script, status)
      detail = "#{controller.script} #{status}: #{result.fetch(:message)}"
      report_action(broker_action, 'completed', detail)
      display(detail)
    when 'sync'
      if Script.running?(controller.script)
        report_action(broker_action, 'failed', "#{controller.script} is already running")
        return
      end
      clear_controller_result(controller)
      Script.run(controller.script, match.script_args, { quiet: true })
      result = normalized_controller_result(controller)
      set_script_status(controller.script, result.fetch(:code))
      publish_snapshot(force: true)
      publish_controller_result(controller, execution_id, result)
      outcome = result.fetch(:ok) ? 'completed' : 'failed'
      report_action(broker_action, outcome, result.fetch(:message))
      display("#{controller.name}: #{result.fetch(:message)}")
    else
      report_action(broker_action, 'failed', 'unsupported controller action kind')
    end
  end

  # Test runs retain instances across cancellation and even an incomplete stop.
  # A new bridge load in this Ruby process must not discard those exclusions.
  @test_run_mutex ||= Mutex.new

  def self.test_runtime_supported?
    Script.respond_to?(:start_child) && Script.respond_to?(:__find_script_file, true) && Script.current &&
      %i[join kill_sync completed_successfully? exit_error file_name].all? { |name| Script.instance_methods.include?(name) }
  end

  def self.test_run_released?(run)
    return true unless run
    return false unless run[:instance] && run[:instance].join(0)
    !run[:runner] || run[:runner].cleanup_complete?
  end

  def self.test_local_snapshot(context)
    raise LabTestRunner::Halt, 'bridge or actions unavailable' unless @running && @actions_enabled && !@snapshot_generation_rejected
    state = snapshot_state
    active = Array(state[:scripts]).map(&:downcase)
    raise LabTestRunner::Halt, 'conflicting script owner' unless (active & context.fetch('excluded_scripts')).empty?
    owned = Array(context['owned_scripts'])
    lane_owners = (state[:owners] || {}).values_at(:movement, :combat).compact.map(&:downcase)
    raise LabTestRunner::Halt, 'conflicting lane owner' unless (lane_owners - owned).empty?
    values = {
      'character' => state[:character], 'generation' => state[:generation],
      'room_id' => state.dig(:room, :id), 'dead' => state[:dead], 'stunned' => state[:stunned],
      'right_hand_id' => state.dig(:hands, :right, :id), 'left_hand_id' => state.dig(:hands, :left, :id)
    }
    # A present hand observation with no object is known empty. An absent
    # observation remains nil and cannot satisfy an unchanged assertion.
    %i[right left].each do |hand|
      hands = state[:hands]
      values["#{hand}_hand_id"] = '' if hands.is_a?(Hash) && hands.key?(hand) && hands[hand].nil?
    end
    # The general hub projection defaults unknown vitals to zero. Assertions
    # need the raw observation so missing never becomes a successful zero.
    %w[health mana spirit].each do |field|
      values[field] = XMLData.respond_to?(field) ? XMLData.public_send(field) : nil
    end
    values
  end

  def self.test_run_control(context)
    return false unless @running && @actions_enabled && !@snapshot_generation_rejected &&
      session_generation == context['generation'] && character_name == context['character']
    action = request(:post, '/v1/actions/status', {action_id: context['action_id']},
                     authorized: true, read_timeout: 0.75)
    %w[action_id character generation command].all? { |key| action[key.to_sym] == context[key] } &&
      action[:expected_room_id].to_s == context['room_id'] &&
      %w[dispatched completed].include?(action[:status]) && action[:stop_requested] == false
  rescue StandardError
    false
  end

  def self.execute_test_controller(action, match)
    controller = match.controller
    raise LabTestRunner::Invalid, 'unsupported loaded Lich lifecycle' unless test_runtime_supported?
    raise LabTestRunner::Invalid, 'session generation changed' unless action[:generation] == session_generation
    root = defined?(SCRIPT_DIR) ? SCRIPT_DIR : $script_dir
    suite_id, revision, case_id = match.script_args.split(' ')
    raise LabTestRunner::Invalid, 'invalid test selector' unless match.script_args == [suite_id, revision, case_id].join(' ') && case_id
    suite = LabTestRunner::Suite.new(root: root, metadata: controller.test_suite,
                                    suite_id: suite_id, revision: revision, case_id: case_id,
                                    resolve: ->(name) { Script.__send__(:__find_script_file, name) })
    owners = controller.owner_scripts.select { |name| Script.running?(name) }
    raise LabTestRunner::Invalid, 'another controller owner is already running' unless owners.empty?
    context = {'action_id' => action.fetch(:action_id), 'character' => action.fetch(:character),
               'generation' => action.fetch(:generation), 'room_id' => action.fetch(:expected_room_id).to_s,
               'expires_at' => action.fetch(:expires_at).to_f,
               'command' => action.fetch(:command), 'suite_id' => suite_id, 'revision' => revision, 'case_id' => case_id,
               'owned_scripts' => [controller.script, suite.data['script']].map(&:downcase),
               'excluded_scripts' => (controller.owner_scripts - [controller.script, suite.data['script']]).map(&:downcase)}
    raise LabTestRunner::Invalid, 'room-bound test context required' unless context['room_id'] == controller.safe_handoff['room_id'].to_s
    state = test_local_snapshot(context)
    raise LabTestRunner::Invalid, 'test preconditions changed' unless
      %w[character generation room_id].all? { |key| state[key] == context[key] } && state['dead'] == false && state['stunned'] == false
    raise LabTestRunner::Invalid, 'test launch revoked' unless test_run_control(context)
    run = {context: context, suite: suite, controller: controller, instance: nil}
    @test_run_mutex.synchronize do
      raise LabTestRunner::Invalid, 'previous test cleanup is incomplete' unless test_run_released?(@test_run)
      @test_run = run
    end
    begin
      clear_controller_result(controller)
      instance = Script.start_child(controller.script, match.script_args, {quiet: true})
      raise LabTestRunner::Invalid, 'test runner did not start' unless instance
      @test_run_mutex.synchronize { run[:instance] = instance }
      set_script_status(controller.script, "starting:#{context['action_id']}")
      Thread.new do
        # A stuck owned child can also delay the wrapper's parent teardown.
        # Deliver its explicit non-success now; admission still retains both
        # exact instances until their joins confirm cleanup.
        sleep 0.05 until instance.join(0) || run.dig(:result, :details, :cleanup_complete) == false
        result = run[:result] || {ok: false, code: 'missing_result', message: 'Test runner exited without a result.', details: {}}
        if result[:ok] && (!instance.completed_successfully? || instance.exit_error)
          result = result.merge(ok: false, code: 'wrapper_failed', message: 'Test wrapper cleanup failed.',
                                details: result[:details].merge(status: 'failed', assertions_passed: false))
        end
        set_script_status(controller.script, "#{result[:code]}:#{context['action_id']}")
        publish_snapshot(force: true)
        publish_controller_result(controller, context['action_id'], result)
      rescue StandardError => error
        Lich.log("lab test monitor failed: #{error.class}")
      end
      report_action(action, 'completed', 'Pinned test runner started; awaiting assertions and cleanup.')
    rescue StandardError
      @test_run_mutex.synchronize { @test_run = nil if @test_run.equal?(run) && !run[:instance] }
      raise
    end
  rescue StandardError => error
    report_action(action, 'failed', "Test admission failed: #{error.class}: #{error.message}")
  end

  def self.run_test_script(instance)
    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 1
    run = nil
    loop do
      run = @test_run_mutex.synchronize { @test_run }
      break if run && run[:instance].equal?(instance)
      raise LabTestRunner::Invalid, 'no exact action-bound runner context' if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline
      sleep 0.01
    end
    raise LabTestRunner::Invalid, 'runner context already claimed' if run[:claimed]
    run[:claimed] = true
    context = run[:context]
    data_root = defined?(DATA_DIR) ? DATA_DIR : File.expand_path('../data', run[:suite].root)
    runner = LabTestRunner::Runner.new(
      suite: run[:suite], context: context, snapshot: -> { test_local_snapshot(context) },
      control: -> { test_run_control(context) }, report_directory: File.join(data_root, 'lab-script-tests'),
      start_child: ->(name, args) { Script.start_child(name, args, {quiet: true}) }
    )
    run[:runner] = runner
    run[:result] = runner.run
    $lab_test_result = run[:result]
  rescue StandardError => error
    if run && run[:instance].equal?(instance)
      run[:result] = {ok: false, code: 'runner_failed', message: "Test runner failed: #{error.class}", details: {}}
      $lab_test_result = run[:result]
    end
    raise
  end

  # One trusted native go2 child, not a pathfinder or arbitrary script runner.
  # The native guard is installed before startup and remains active in cleanup.
  def self.execute_go2(action, destination)
    child = nil
    closed = false
    launching = false
    unless destination.match?(/\A[1-9][0-9]{0,9}\z/) && destination != '4' && Map[destination.to_i]
      raise ArgumentError, 'go2 requires an explicit mapped destination'
    end
    unless Script.const_defined?(:START_EXECUTION_GUARD_PROTOCOL) && Script::START_EXECUTION_GUARD_PROTOCOL == 1 &&
           Script.const_defined?(:SCRIPT_START_RESTRICTION_PROTOCOL) && Script::SCRIPT_START_RESTRICTION_PROTOCOL == 1
      raise ArgumentError, 'go2 requires native guarded child startup'
    end
    relative = Script.__send__(:__find_script_file, 'go2')
    root = defined?(SCRIPT_DIR) ? SCRIPT_DIR : $script_dir
    unless relative.is_a?(String) && root.is_a?(String) && File.read(File.join(root, relative)).include?('--preserve-scripts')
      raise ArgumentError, 'go2 requires the one-trip preserve-scripts option'
    end
    prefix = $cmd_prefix
    raise ArgumentError, 'game command prefix unavailable' unless prefix.is_a?(String)
    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + [action.fetch(:expires_at) - Time.now.to_f, 120].min
    owner = Script.current
    hands = -> { [GameObj.right_hand&.id&.to_s, GameObj.left_hand&.id&.to_s] }
    original_hands = hands.call
    available = lambda do |_request|
      next false if closed || !@running || !@actions_enabled || @snapshot_generation_rejected || owner.stopping?
      next false unless action[:generation] == session_generation && action[:character].to_s.casecmp?(character_name)
      next false unless Process.clock_gettime(Process::CLOCK_MONOTONIC) < deadline && hands.call == original_hands
      next false unless XMLData.indicator['IconDEAD'] == 'n' && XMLData.indicator['IconSTUNNED'] == 'n'
      scripts = (Array(Script.running) + Array(Script.hidden)).uniq
      scripts = scripts.reject { |candidate| child && candidate.equal?(child) && owner.child_scripts.any? { |owned| owned.equal?(child) } }
      names = scripts.map { |script| script.name.to_s }
      owners = script_owners(names)
      %i[movement combat inventory].all? { |lane| owners[lane].nil? }
    end
    lease = LabControllerControls::Lease.new(action: action, available: available,
      authority: method(:controlled_action_authority), clock: -> { Time.now.to_f })
    raise ArgumentError, 'go2 authority or ownership unavailable' unless lease.refresh
    sends = 0
    lock = Mutex.new
    guard = lambda do |wire|
      sleep 0.001 while launching && Process.clock_gettime(Process::CLOCK_MONOTONIC) < deadline
      lock.synchronize do
        next false unless child && lease.valid?
        if wire
          command = wire.delete_prefix(prefix) if wire.is_a?(String) && wire.start_with?(prefix)
          # A mapped go2 edge may legitimately prepare/cast a spell, operate an
          # obstacle, pay a fare, or perform another transition-specific game
          # command. The authority boundary is the exact guarded go2 child and
          # approved destination, not a second, inevitably incomplete verb list.
          next false unless command && !command.empty? && command.bytesize <= 1024 &&
                            !command.match?(/[\r\n]/) && room_fingerprint != 'unknown' && sends < 256
          sends += 1
        end
        true
      end
    end
    launching = true
    child = Script.start_child('go2', "#{destination} --disable-confirm --typeahead=0 --get-silvers=off --stop-for-dead=off --preserve-scripts",
                               {quiet: true, execution_guard: guard, allow_script_starts: false})
    launching = false
    raise ArgumentError, 'go2 native child startup failed' unless child && owner.child_scripts.any? { |owned| owned.equal?(child) }
    until child.join(0)
      raise ArgumentError, 'go2 authority, deadline or ownership lost' unless lease.refresh
      sleep 0.05
    end
    unless child.completed_successfully? && lease.valid? && room_fingerprint == destination && hands.call == original_hands &&
           XMLData.indicator['IconSTANDING'] == 'y'
      raise ArgumentError, 'go2 arrival, survival or equipment handoff unverified'
    end
    set_script_status('go2', "completed:#{action.fetch(:action_id)}")
    publish_snapshot(force: true)
    report_action(action, 'completed', "go2 destination arrival and exact child exit verified (#{sends} sends)")
  rescue StandardError => error
    set_script_status('go2', "failed:#{action.fetch(:action_id)}")
    report_action(action, 'failed', "go2 travel failed: #{error.message}")
  ensure
    launching, closed = false, true
    lease&.revoke
    if child && !child.join(0) && !child.kill_sync(timeout: 2)
      display('go2 cleanup incomplete; do not start another operation until its owner has exited.')
    end
    publish_snapshot(force: true)
  end

  def self.execute_action(action)
    @execution_mutex.synchronize do
      commands = action_commands(action)
      command = commands.first
      defer_snapshot = false
      unless @actions_enabled
        report_action(action, 'failed', 'local kill switch is off')
        return
      end
      unless action.fetch(:character).casecmp?(character_name)
        report_action(action, 'failed', 'character changed before execution')
        return
      end
      unless commands.all? { |candidate| safe_action_command?(candidate) }
        report_action(action, 'failed', 'Lich-side allowlist rejected command')
        @actions_enabled = false
        display('action rejected locally; kill switch engaged')
        return
      end
      if Time.now.to_f >= action.fetch(:expires_at).to_f
        report_action(action, 'failed', 'action expired before execution')
        return
      end
      expected_room = action[:expected_room_id]
      if expected_room && expected_room.to_s != room_fingerprint
        report_action(action, 'failed', 'room changed before execution')
        return
      end

      if commands.all? { |candidate| %w[info skills].include?(candidate.downcase) }
        execute_action_sequence(action, commands)
        return
      end

      if commands.length > 1
        unless commands.all? { |candidate| safe_sequence_command?(candidate) }
          report_action(action, 'failed', 'Lich-side sequence allowlist rejected command')
          @actions_enabled = false
          display('sequence rejected locally; kill switch engaged')
          return
        end
        execute_action_sequence(action, commands)
        return
      end

      if command.casecmp?('inspect ready weapon links')
        inspect_ready_weapon_links(action)
        return
      elsif (inspection_match = command.match(/\Ainspect item exact (.+)\z/i))
        inspect_exact_item(action, inspection_match[1])
        return
      elsif (diagnostic_match = command.match(/\Adiagnose item (405|735) exact (.+)\z/i))
        diagnose_exact_item(action, diagnostic_match[1], diagnostic_match[2])
        return
      elsif (exact_examination = command.match(/\A(look|inspect) #([0-9]+)\z/i))
        examine_exact_id(action, exact_examination[1].downcase, exact_examination[2])
        return
      elsif (go2_match = command.match(/\Ago2 supervised ([1-9][0-9]{0,9})\z/i))
        execute_go2(action, go2_match[1])
        return
      elsif (go2_match = command.match(/\Ago2 ([0-9]+)\z/i))
        destination = go2_match[1]
        Script.run('go2', "#{destination} --disable-confirm", { quiet: true })
      elsif (go2_setting = command.match(/\Ago2 getsilvers (on|off)\z/i))
        Script.run('go2', "getsilvers=#{go2_setting[1].downcase}", { quiet: true })
      elsif command.casecmp?('eloot keep closed on')
        Script.run('eloot', 'settings keep_closed true', { quiet: true })
      elsif command.casecmp?('eloot loot')
        unless Script.running?('eloot')
          execution_id = action.fetch(:action_id).to_s
          set_script_status('eloot', "starting:#{execution_id}")
          Script.run('eloot', nil, { quiet: true })
          monitor = monitor_script_completion('eloot', execution_id: execution_id)
          monitor.join(22)
          status = @script_status_mutex.synchronize { @script_status['eloot'] }
          unless status == "completed:#{execution_id}"
            report_action(action, 'failed', "eloot did not complete: #{status}")
            return
          end
          defer_snapshot = true
        end
      elsif command.casecmp?('eloot sell')
        Script.run('eloot', 'sell', { quiet: true })
      elsif command.casecmp?('eloot stop')
        Script.kill('eloot') if Script.running?('eloot')
        set_script_status('eloot', 'stopped')
      elsif command.casecmp?('eherbs heal')
        staunching = defined?(Spell) && Spell.respond_to?(:[]) && Spell[9909]&.active?
        unless staunching
          report_action(action, 'failed', 'Sign of Staunching is not active; refusing EHerbs recovery')
          return
        end
        if Script.running?('eherbs')
          report_action(action, 'failed', 'eherbs is already running')
          return
        end
        execution_id = action.fetch(:action_id).to_s
        set_script_status('eherbs', "starting:#{execution_id}")
        Script.run('eherbs', '--buy=off --deposit=off --skipscars=on', { quiet: true })
        monitor = monitor_script_completion(
          'eherbs',
          execution_id: execution_id,
          completion_timeout: 90
        )
        monitor.join(92)
        status = @script_status_mutex.synchronize { @script_status['eherbs'] }
        unless status == "completed:#{execution_id}"
          report_action(action, 'failed', "eherbs did not complete: #{status}")
          return
        end
        defer_snapshot = true
      elsif command.casecmp?('bigshot start')
        unless launch_bigshot
          report_action(action, 'failed', 'bigshot did not start')
          return
        end
      elsif command.casecmp?('bigshot stop')
        Script.kill('bigshot') if Script.running?('bigshot')
      elsif command.casecmp?('ebounty start')
        Script.run('ebounty', nil, { quiet: true }) unless Script.running?('ebounty')
      elsif command.casecmp?('ebounty stop')
        Script.kill('ebounty') if Script.running?('ebounty')
      elsif (controller_match = CONTROLLER_REGISTRY.match(command))
        execute_controller_action(action, controller_match)
        return
      else
        prepare_inventory_capture(command)
        fput(command)
      end
      publish_snapshot(force: true) unless defer_snapshot
      report_action(action, 'completed', 'command sent')
      display("executed [#{action.fetch(:action_id)}]: #{command}")
    rescue => error
      report_action(action, 'failed', "#{error.class}: #{error.message}")
      display("action failed (#{error.message})")
    end
  end

  def self.action_loop
    while @running
      break if @snapshot_generation_rejected
      unless @actions_enabled
        sleep 0.25
        next
      end

      begin
        reconcile_action_registration
        body = request(
          :post,
          '/v1/actions/next',
          {
            character: character_name,
            room_id: room_fingerprint,
            generation: session_generation,
            timeout_seconds: 15
          },
          read_timeout: 17,
          authorized: true
        )
        action = body[:action]
        next unless action

        if action[:status] == 'confirmation_required'
          @pending_approval_id = action.fetch(:action_id)
          display("approval needed [#{action.fetch(:action_id)}]: #{action_description(action)}")
          if @auto_approve
            display('auto-approving allowlisted action')
            approve_action(action.fetch(:action_id), 'auto')
          else
            display('use ;lab approve within a few seconds')
          end
        elsif action[:status] == 'execute'
          execute_action(action)
        else
          Lich.log("lab bridge ignored unknown action status: #{action[:status].inspect}")
        end
      rescue => error
        if Time.now - @last_action_error_at > 30
          Lich.log("lab bridge action polling paused: #{error.class}: #{error.message}")
          @last_action_error_at = Time.now
        end
        sleep 1
      end
    end
  end

  def self.handle_command(command)
    request = command.to_s.strip
    case request.downcase
    when '', 'help'
      display('usage: , QUESTION | ;lab status|state|scripts|inventory|last|alerts|sources|context|forget | ;lab do item audit #ID | ;lab do hunt prepare | ;lab do room loot | ;lab operation stop | ;lab actions on|off | ;lab approve [ID] | ;lab approve auto [off] | ;lab stop')
      display('recovery: ;lab recover lists failed controlled outings; ;lab recover RUN_ID confirm verifies one safe handoff without changing its test result')
    when 'status'
      run_command_async { status }
    when 'state'
      show_state
    when 'scripts'
      show_scripts
    when 'inventory'
      show_inventory
    when 'last'
      show_last
    when 'alerts'
      run_command_async { show_alerts }
    when 'sources'
      run_command_async { show_sources }
    when 'context'
      run_command_async { show_context }
    when 'forget'
      run_command_async { forget_context }
    when 'do hunt prepare'
      run_command_async { start_capability('hunt.prepare') }
    when 'do room loot'
      run_command_async { start_capability('room.loot') }
    when /\Ado item audit #?([0-9]+)(?:\s+(.+))?\z/
      object_id = Regexp.last_match(1)
      raw_methods = Regexp.last_match(2).to_s
      methods = raw_methods.empty? ? %w[look inspect] : raw_methods.split(/[ ,]+/)
      unless methods.all? { |method| %w[look inspect 405 735].include?(method) }
        display('item audit methods must be look, inspect, 405, or 735')
        return nil
      end
      run_command_async do
        start_capability('item.audit', { item_id: object_id, methods: methods })
      end
    when 'operation stop'
      run_command_async { stop_capability }
    when 'recover'
      recover_controlled_handoff
    when /\Arecover ([0-9a-f]{16}) confirm\z/
      action_id = Regexp.last_match(1)
      recover_controlled_handoff(action_id, confirm: true)
    when 'actions on'
      run_command_async { set_actions(true) }
    when 'actions off'
      @actions_enabled = false
      @pending_approval_id = nil
      @auto_approve = false
      run_command_async { set_actions(false) }
    when 'approve auto', 'approve auto on'
      @auto_approve = true
      display('auto-approve ON for allowlisted actions; use ;lab approve auto off to disable')
    when 'approve auto off'
      @auto_approve = false
      display('auto-approve OFF')
    when 'approve'
      if @pending_approval_id
        action_id = @pending_approval_id
        run_command_async { approve_action(action_id) }
      else
        display('no pending action to approve')
      end
    when /\Aapprove\s+([0-9a-f]{16})\z/
      action_id = Regexp.last_match(1)
      run_command_async { approve_action(action_id) }
    when /\Aask\s+(.+)\z/i
      question = Regexp.last_match(1).strip
      run_command_async { ask(question) }
    when /\Ainventory\s+(.+)\z/i
      if defined?(LabInventory) && LabInventory.respond_to?(:handle_request)
        LabInventory.handle_request(Regexp.last_match(1))
      else
        display('inventory tracker is not ready')
      end
    else
      display("unknown command '#{request}'; use ;lab help")
    end
    nil
  rescue => error
    Lich.log("LAB bridge command error: #{error.class}: #{error.message}")
    display("command failed: #{error.message}")
    nil
  end

  def self.handle_input(client_string)
    command = client_string.sub(/\A<c>/, '').strip
    if command.match?(/\A,sol(?:\s|\z)/i)
      display('Sol was renamed; use ;lab for bridge commands or , QUESTION to talk')
      return nil
    end

    match = command.match(/\A,\s*(.*)\z/m)
    return client_string unless match

    question = match[1].to_s.strip
    if question.empty?
      display('usage: , QUESTION')
    else
      Thread.new { ask(question) }
    end
    nil
  rescue => error
    Lich.log("LAB bridge input error: #{error.class}: #{error.message}")
    display("question failed: #{error.message}")
    nil
  end

  def self.stop
    @running = false
    @actions_enabled = false
    @pending_approval_id = nil
    @auto_approve = false
    @command_queue << nil
    @sequence_response_mutex.synchronize { @sequence_response_cv.broadcast }
    UpstreamHook.remove(UPSTREAM_HOOK)
    DownstreamHook.remove(DOWNSTREAM_HOOK)
  end
end

unless ENV['LAB_BRIDGE_LIBRARY_ONLY'] == '1'
  before_dying { LichAgentBridge.stop }
  UpstreamHook.add(LichAgentBridge::UPSTREAM_HOOK, proc { |line| LichAgentBridge.handle_input(line) }, persist: false)
  DownstreamHook.add(LichAgentBridge::DOWNSTREAM_HOOK, proc { |line| LichAgentBridge.capture(line) }, persist: false)
  Thread.new { LichAgentBridge.command_loop }
  Thread.new { LichAgentBridge.publish_loop }
  Thread.new do
    begin
      LichAgentBridge.publish_snapshot(force: true)
    rescue => error
      Lich.log("LAB bridge initial snapshot unavailable: #{error.class}: #{error.message}")
    end
    LichAgentBridge.set_actions(true) unless LichAgentBridge.instance_variable_get(:@snapshot_generation_rejected)
    LichAgentBridge.action_loop
  end
  LichAgentBridge.ensure_inventory_tracker

  LichAgentBridge.display('agent bridge started; enabling actions and allowlisted auto-approval; use , QUESTION or ;lab status')
  sleep while true
end
