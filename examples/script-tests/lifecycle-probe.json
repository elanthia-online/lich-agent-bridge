{
  "version": 1,
  "id": "lifecycle-probe",
  "script": "lab-lifecycle-probe",
  "files": ["lab-lifecycle-probe.lic"],
  "cases": [
    {
      "id": "normal",
      "args": ["normal"],
      "assertions": [
        {"field": "room_id", "op": "unchanged"},
        {"field": "right_hand_id", "op": "unchanged"},
        {"field": "left_hand_id", "op": "unchanged"},
        {"field": "dead", "op": "equals", "value": false}
      ]
    },
    {
      "id": "intentional-error",
      "args": ["error"],
      "assertions": [
        {"field": "room_id", "op": "unchanged"},
        {"field": "right_hand_id", "op": "unchanged"},
        {"field": "left_hand_id", "op": "unchanged"}
      ]
    }
  ],
  "limits": {"case_seconds": 2, "run_seconds": 10, "cleanup_seconds": 2}
}
